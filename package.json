{
  "name": "davinci-notes-workspace",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:public-tokens": "node scripts/check-public-tokens.mjs",
    "check:version-sync": "bash scripts/release/check-version-sync.sh",
    "test:public-tokens": "node --test scripts/check-public-tokens.test.mjs",
    "manage": "bash scripts/manage.sh",
    "tui": "bash scripts/manage.sh",
    "tauri": "pnpm --filter @app/desktop tauri",
    "desktop:build": "pnpm --filter @app/desktop build",
    "desktop:dev": "pnpm --filter @app/desktop dev",
    "deploy:cloudflare": "bash scripts/deploy-cloudflare.sh",
    "fix:damaged": "bash scripts/manage.sh -f",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@typescript-eslint/eslint-plugin": "^7.1.0",
    "@typescript-eslint/parser": "^7.1.0",
    "eslint": "^8.57.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-boundaries": "^4.2.2",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "pnpm": {
    "overrides": {
      "@expo/dom-webview": "57.0.1",
      "@expo/log-box": "57.0.4",
      "@app/editor>react": "19.2.3",
      "@app/editor>react-dom": "19.2.3"
    }
  },
  "packageManager": "pnpm@10.27.0"
}
