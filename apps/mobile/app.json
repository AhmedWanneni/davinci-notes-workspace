{
  "expo": {
    "name": "Sophia",
    "slug": "davinci-notes",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "davinci",
    "icon": "./assets/sophia-icon.png",
    "splash": {
      "image": "./assets/sophia-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2B1F1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davinci.notes",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSCameraUsageDescription": "Allow Sophia to take photos to attach to your notes.",
        "NSPhotoLibraryUsageDescription": "Allow Sophia to attach photos from your library.",
        "NSMicrophoneUsageDescription": "Allow Sophia to record audio voice memos."
      }
    },
    "android": {
      "package": "com.davinci.notes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/sophia-icon.png",
        "backgroundColor": "#2B1F1A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Sophia to attach photos from your library.",
          "cameraPermission": "Allow Sophia to take photos to attach to your notes."
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/withLocalhostNetworkSecurity",
      "./plugins/withSyncthingAndroid",
      "expo-asset",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/sophia-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#2B1F1A"
        }
      ]
    ]
  }
}
