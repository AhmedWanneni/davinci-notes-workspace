{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@app/canvas": ["../../packages/canvas/index.ts"],
      "@app/attachments": ["../../packages/attachments/index.ts"],
      "@app/core-types": ["../../packages/core-types/index.ts"],
      "@app/design-system": ["../../packages/design-system/index.ts"],
      "@app/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@app/design-tokens/*": ["../../packages/design-tokens/*"],
      "@app/editor": ["../../packages/editor/index.ts"],
      "@app/indexer": ["../../packages/indexer/index.ts"],
      "@app/plugin-api": ["../../packages/plugin-api/index.ts"],
      "@app/plugin-runtime": ["../../packages/plugin-runtime/index.ts"],
      "@app/theme-api": ["../../packages/theme-api/index.ts"],
      "@app/ai-api": ["../../packages/ai-api/index.ts"],
      "@app/ai-runtime": ["../../packages/ai-runtime/index.ts"],
      "@app/ai-embeddings": ["../../packages/ai-embeddings/index.ts"],
      "@app/ai-qa": ["../../packages/ai-qa/index.ts"],
      "@app/sync-client": ["../../packages/sync-client/index.ts"],
      "@app/syncthing-api": ["../../packages/syncthing-api/index.ts"],
      "expo-syncthing": ["./modules/expo-syncthing/index.ts"],
      "expo-syncthing/*": ["./modules/expo-syncthing/*"]
    },
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "**/*",
    "nativewind-env.d.ts"
  ]
}
