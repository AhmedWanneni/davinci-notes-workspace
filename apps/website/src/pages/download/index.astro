---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import '../../styles/download.css';

const REPO = 'AhmedWanneni/davinci-notes-workspace';
const DEFAULT_VERSION = 'v0.3.0';
const cleanVer = DEFAULT_VERSION.replace(/^v/, '');

let releaseVersion = DEFAULT_VERSION;
let releaseDate = 'Latest Release';

const fallbackAssets = {
  macArm: `https://github.com/${REPO}/releases/latest/download/Sophia_${cleanVer}_aarch64.dmg`,
  macIntel: `https://github.com/${REPO}/releases/latest/download/Sophia_${cleanVer}_x64.dmg`,
  windows: `https://github.com/${REPO}/releases/latest/download/Sophia_${cleanVer}_x64-setup.exe`,
  linuxAppImage: `https://github.com/${REPO}/releases/latest/download/sophia_${cleanVer}_amd64.AppImage`,
  linuxDeb: `https://github.com/${REPO}/releases/latest/download/sophia_${cleanVer}_amd64.deb`,
  androidApk: `https://github.com/${REPO}/releases/latest/download/Sophia_${cleanVer}.apk`,
  iosIpa: `https://github.com/${REPO}/releases/latest/download/Sophia_${cleanVer}.ipa`,
  checksums: `https://github.com/${REPO}/releases/latest/download/SHA256SUMS.txt`,
};

let assets = { ...fallbackAssets };

try {
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases/latest`, {
    headers: { 'User-Agent': 'DaVinciNotes-Website-Builder' },
  });
  if (res.ok) {
    const data = await res.json();
    releaseVersion = data.tag_name || DEFAULT_VERSION;
    if (data.published_at) {
      releaseDate = new Date(data.published_at).toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });
    }
    if (Array.isArray(data.assets)) {
      const apkAsset = data.assets.find((a: any) => a.name.endsWith('.apk'));
      if (apkAsset) assets.androidApk = apkAsset.browser_download_url;
      const ipaAsset = data.assets.find((a: any) => a.name.endsWith('.ipa'));
      if (ipaAsset) assets.iosIpa = ipaAsset.browser_download_url;
    }
  }
} catch {
  // Use fallback defaults on network/rate-limit failure
}
---

<BaseLayout
  title="Download DaVinci Notes — Desktop App for Mac, Windows & Linux"
  description="Download DaVinci Notes / Sophia for macOS (Apple Silicon & Intel), Windows, and Linux. Private, local-first, zero-backend knowledge base."
>
  <SiteNav />

  <main class="download-page">
    <section class="download-hero">
      <span class="download-badge">Release {releaseVersion} • {releaseDate}</span>
      <h1 class="download-title">Download DaVinci Notes</h1>
      <p class="download-subtitle">
        Your notes, thoughts, and knowledge securely kept on your machine.
        Local-first, fast, and completely private.
      </p>

      <div class="primary-cta-container">
        <a
          id="primary-download-btn"
          href={assets.macArm}
          class="btn-download-primary"
        >
          <span>Download for macOS</span>
          <span aria-hidden="true">↓</span>
        </a>
        <span id="detected-os-label" class="detected-os-text">
          Detecting operating system...
        </span>
      </div>

      <div class="quick-terminal-box" style="margin-top: 1.5rem; padding: 0.75rem 1.25rem; border: 1px dashed var(--logseq-border); border-radius: 6px; background: rgba(0,0,0,0.03); display: inline-block;">
        <span style="display: block; font-size: 0.8rem; color: var(--logseq-text-muted); margin-bottom: 0.35rem;">⚡ Fast 1-Line Free Install (Zero Gatekeeper Prompts):</span>
        <code style="font-family: var(--font-mono); font-size: 0.85rem; color: var(--logseq-cyan); user-select: all; cursor: pointer;">curl -fsSL https://sophia-notes.pages.dev/install.sh | bash</code>
      </div>
    </section>

    <section class="platforms-grid">
      <!-- macOS -->
      <div class="platform-card">
        <div class="platform-card-header">
          <h2 class="platform-card-title">macOS</h2>
          <span class="file-type-badge">macOS 11+</span>
        </div>
        <p class="verification-text">Apple Silicon (M1/M2/M3/M4) and Intel 64-bit</p>
        <div class="platform-links-list">
          <a href={assets.macArm} class="platform-link-row">
            <span>Apple Silicon (.dmg)</span>
            <span class="file-type-badge">arm64</span>
          </a>
          <a href={assets.macIntel} class="platform-link-row">
            <span>Intel (.dmg)</span>
            <span class="file-type-badge">x64</span>
          </a>
        </div>
        <div style="margin-top: 10px; padding: 6px 10px; background: rgba(0,0,0,0.03); border: 1px dashed var(--logseq-border); border-radius: 4px; font-size: 0.75rem;">
          <span style="font-weight: 600;">🍺 Homebrew Cask:</span><br />
          <code style="font-family: var(--font-mono); color: var(--logseq-cyan); user-select: all;">brew install --cask ahmedwanneni/sophia/sophia</code>
        </div>
        <p class="verification-text" style="margin-top: 8px; font-size: 0.72rem; opacity: 0.85;">
          💡 <em>DMG First-time:</em> Right-click → <strong>Open</strong>, or allow via <strong>System Settings → Privacy &amp; Security</strong>.
        </p>
      </div>

      <!-- Windows -->
      <div class="platform-card">
        <div class="platform-card-header">
          <h2 class="platform-card-title">Windows</h2>
          <span class="file-type-badge">Windows 10 / 11</span>
        </div>
        <p class="verification-text">Installer and portable executable for 64-bit systems</p>
        <div class="platform-links-list">
          <a href={assets.windows} class="platform-link-row">
            <span>Setup Installer (.exe)</span>
            <span class="file-type-badge">x64</span>
          </a>
        </div>
      </div>

      <!-- Linux -->
      <div class="platform-card">
        <div class="platform-card-header">
          <h2 class="platform-card-title">Linux</h2>
          <span class="file-type-badge">Standard Distros</span>
        </div>
        <p class="verification-text">Universal AppImage and Debian/Ubuntu packages</p>
        <div class="platform-links-list">
          <a href={assets.linuxAppImage} class="platform-link-row">
            <span>Universal AppImage (.AppImage)</span>
            <span class="file-type-badge">x64</span>
          </a>
          <a href={assets.linuxDeb} class="platform-link-row">
            <span>Debian / Ubuntu (.deb)</span>
            <span class="file-type-badge">x64</span>
          </a>
        </div>
      </div>

      <!-- Android -->
      <div class="platform-card">
        <div class="platform-card-header">
          <h2 class="platform-card-title">Android</h2>
          <span class="file-type-badge">Android 10+</span>
        </div>
        <p class="verification-text">Direct APK package with embedded Syncthing (ARM64 & x86_64)</p>
        <div class="platform-links-list">
          <a href={assets.androidApk} class="platform-link-row">
            <span>Direct APK (.apk)</span>
            <span class="file-type-badge">Universal</span>
          </a>
        </div>
        <p class="verification-text" style="margin-top: 8px; font-size: 0.72rem; opacity: 0.85;">
          💡 <em>First-time install:</em> Tap <strong>Download</strong> and allow "Install from unknown sources" if prompted.
        </p>
      </div>

      <!-- iOS -->
      <div class="platform-card">
        <div class="platform-card-header">
          <h2 class="platform-card-title">iOS</h2>
          <span class="file-type-badge">iOS 16+</span>
        </div>
        <p class="verification-text">iPhone & iPad package (Sideload / AltStore / TrollStore)</p>
        <div class="platform-links-list">
          <a href={assets.iosIpa} class="platform-link-row">
            <span>iOS Package (.ipa)</span>
            <span class="file-type-badge">Universal</span>
          </a>
        </div>
        <p class="verification-text" style="margin-top: 8px; font-size: 0.72rem; opacity: 0.85;">
          💡 Sideloadable via <strong>AltStore</strong>, <strong>SideStore</strong>, or <strong>TrollStore</strong>.
        </p>
      </div>
    </section>

    <section class="verification-section">
      <div class="verification-box">
        <div class="verification-heading">🔒 Cryptographic Verification</div>
        <div class="verification-text">
          Every release publishes signed SHA-256 checksums. Verify your download:
          <br />
          <code>curl -sL {assets.checksums} | sha256sum -c</code>
          <br /><br />
          Looking for older versions?
          <a
            href={`https://github.com/${REPO}/releases`}
            target="_blank"
            rel="noreferrer"
            style="color: var(--logseq-cyan); text-decoration: underline;"
          >
            Browse all releases on GitHub ↗
          </a>
          &nbsp;•&nbsp;
          <a
            href="/download/beta"
            style="color: var(--logseq-cyan); text-decoration: underline;"
          >
            Beta Pre-Release Channel ↗
          </a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />

  <script is:inline define:vars={{ assets }}>
    (function () {
      const ua = navigator.userAgent || '';
      const platform = (navigator.userAgentData?.platform || navigator.platform || '').toLowerCase();
      const primaryBtn = document.getElementById('primary-download-btn');
      const label = document.getElementById('detected-os-label');

      if (!primaryBtn || !label) return;

      if (/android/i.test(platform) || /android/i.test(ua)) {
        primaryBtn.href = assets.androidApk;
        primaryBtn.innerHTML = '<span>Download for Android (.apk)</span> <span aria-hidden="true">↓</span>';
        label.textContent = 'Detected Android';
      } else if (/iphone|ipad|ipod/i.test(platform) || /iphone|ipad|ipod/i.test(ua)) {
        primaryBtn.href = assets.iosIpa;
        primaryBtn.innerHTML = '<span>Download for iOS (.ipa)</span> <span aria-hidden="true">↓</span>';
        label.textContent = 'Detected iOS';
      } else if (/win/i.test(platform) || /windows/i.test(ua)) {
        primaryBtn.href = assets.windows;
        primaryBtn.innerHTML = '<span>Download for Windows</span> <span aria-hidden="true">↓</span>';
        label.textContent = 'Detected Windows (64-bit)';
      } else if (/linux/i.test(platform) || /linux/i.test(ua)) {
        primaryBtn.href = assets.linuxAppImage;
        primaryBtn.innerHTML = '<span>Download for Linux</span> <span aria-hidden="true">↓</span>';
        label.textContent = 'Detected Linux (.AppImage)';
      } else {
        // Default to macOS
        primaryBtn.href = assets.macArm;
        primaryBtn.innerHTML = '<span>Download for macOS</span> <span aria-hidden="true">↓</span>';
        label.textContent = 'Detected macOS (Apple Silicon)';
      }
    })();
  </script>
</BaseLayout>
