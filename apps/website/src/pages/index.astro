---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
import HeroSection from '../components/hero/HeroSection.astro';
import WavyDivider from '../components/WavyDivider.astro';
import AppWorkbenchDemo from '../components/AppWorkbenchDemo.astro';
import WhatYouCanDoSection from '../components/WhatYouCanDoSection.astro';
import ThoughtsStage from '../components/ThoughtsStage.astro';
import SyncSection from '../components/SyncSection.astro';
import NotesStayYoursSection from '../components/NotesStayYoursSection.astro';
import CommunitySection from '../components/CommunitySection.astro';
import ClosingSection from '../components/ClosingSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout
  title="Sophia Notes — Every thought in your head, organized in one place."
  description="A local-first, privacy-focused open source note-taking and knowledge base application. Connect your thoughts with linked references, graph views, and flashcards."
>
  <SiteNav />

  <main id="top">
    <!-- Pattern 1: Monumental Centered Display + Bottom-Anchored Owl Illustration -->
    <HeroSection />

    <!-- Pattern 2: Full-Fidelity 3-Pane Desktop Application Workbench Demo -->
    <AppWorkbenchDemo />
    <WavyDivider />

    <!-- Pattern 3: Pinned Index Cards with Alternating Micro-Tilts & Vector Doodles -->
    <WhatYouCanDoSection />

    <!-- Pattern 4: Freeform 2D Visual Canvas & Clutter-to-Clarity Transformation -->
    <ThoughtsStage />

    <!-- Pattern 5: Two-Column Split Layout with Real-Time Peer Sync Card -->
    <SyncSection />
    <WavyDivider />

    <!-- Pattern 6: Organic Parchment Data Sovereignty Plaque -->
    <NotesStayYoursSection />

    <!-- Pattern 7: Open Source Community Hub -->
    <CommunitySection />

    <!-- Pattern 8: Final Illuminated Call-to-Action Card -->
    <ClosingSection />
  </main>

  <SiteFooter />
</BaseLayout>
