---
import './NotesStayYoursSection.css';
---

<section class="notes-stay-yours-section" id="sovereignty" aria-labelledby="sovereignty-heading">
  <div class="logseq-container">
    <div class="notes-stay-banner">
      <div class="notes-stay-kicker">Data Sovereignty</div>
      <h2 id="sovereignty-heading" class="notes-stay-title">
        Your notes stay yours forever.
      </h2>
      <p class="notes-stay-desc">
        No accounts required. No monthly subscriptions. No proprietary file locks.
        Every note you write is saved as plain text on your own computer—accessible today,
        tomorrow, and decades from now.
      </p>

      <div class="notes-stay-points">
        <div class="notes-stay-point">
          <span class="notes-stay-point-icon" aria-hidden="true">✓</span>
          <span>100% Offline Capable</span>
        </div>
        <div class="notes-stay-point">
          <span class="notes-stay-point-icon" aria-hidden="true">✓</span>
          <span>Plain Markdown Files</span>
        </div>
        <div class="notes-stay-point">
          <span class="notes-stay-point-icon" aria-hidden="true">✓</span>
          <span>Open Source Forever</span>
        </div>
      </div>

      <div class="notes-stay-actions">
        <a href="#download" class="btn-logseq-primary">
          <span>Download for Desktop</span>
          <span class="btn-arrow" aria-hidden="true">⌵</span>
        </a>
        <a href="https://github.com" target="_blank" rel="noreferrer" class="btn-notes-secondary">
          <span>Explore on GitHub ↗</span>
        </a>
      </div>
    </div>
  </div>
</section>
