---
---

<section class="logseq-community-section" id="community">
  <div class="logseq-container community-inner">
    <h3 class="community-title">A helpful community</h3>

    <div class="community-cards-grid">
      <!-- Discord Card -->
      <a href="https://discord.com" target="_blank" rel="noreferrer" class="community-card">
        <div class="community-btn-row">
          <svg class="community-icon" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.893.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <span class="btn-text">Join our Discord</span>
          <span class="btn-arrow">→</span>
        </div>
        <div class="community-meta">
          <span class="live-dot" aria-hidden="true"></span>
          <span><strong>2,012</strong> users online currently</span>
        </div>
      </a>

      <!-- Forum Card -->
      <a href="#forum" class="community-card">
        <div class="community-btn-row">
          <svg class="community-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
          <span class="btn-text">Join our forum</span>
          <span class="btn-arrow">→</span>
        </div>
        <div class="community-meta">
          <span>Feature requests, bugs, discussions</span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .logseq-community-section {
    padding: 70px 0 80px;
    background-color: var(--logseq-bg);
    text-align: center;
  }

  .community-title {
    margin: 0 0 32px;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 500;
    color: var(--logseq-text-title);
    letter-spacing: -0.01em;
  }

  .community-cards-grid {
    display: flex;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    max-width: 720px;
    margin: 0 auto;
  }

  .community-card {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--logseq-card);
    border: 1.5px solid var(--logseq-border);
    border-radius: var(--radius-hand-drawn-subtle);
    padding: 18px 24px;
    box-shadow: none !important;
    transition: all 150ms ease;
  }

  .community-card:hover {
    background-color: var(--logseq-card-hover);
    border-color: var(--logseq-cyan);
    transform: translateY(-2px);
  }

  .community-btn-row {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--logseq-text-title);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 8px;
  }

  .community-icon {
    color: var(--logseq-cyan);
  }

  .btn-arrow {
    color: var(--logseq-cyan);
    font-size: .5rem;
    transition: transform 150ms ease;
  }

  .community-card:hover .btn-arrow {
    transform: translateX(3px);
  }

  .community-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
    color: var(--logseq-text-muted);
  }

  .community-meta strong {
    color: var(--logseq-text-title);
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--accent-olive);
    border: 1px solid #3a452a;
    box-shadow: none !important;
  }
</style>
