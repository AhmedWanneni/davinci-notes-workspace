---

<section class="workbench-section" id="workbench" aria-labelledby="workbench-heading">
  <div class="swiss-shell">
    <!-- Scroll Convergence Funnel Header -->
    <div class="convergence-funnel" aria-hidden="true">
      <div class="funnel-stem"></div>
      <span class="funnel-tag">↓ ORBITAL THOUGHTS CONVERGE INTO PLAIN FILES ON DISK ↓</span>
    </div>

    <div class="section-header-grid">
      <div>
        <p class="kicker-index">01 / THE WORKBENCH · LIVE VAULT BLUEPRINT</p>
        <h2 id="workbench-heading" class="display-section">
          From orbital chaos to<br />
          <em>structured local clarity.</em>
        </h2>
      </div>
      <p class="editorial-lead section-sublead">
        Scroll past the mind and every floating card, formula, and sketch locks
        into DaVinci’s three-pane Obsidian-grade workspace. Inspect four real
        workflows below:
      </p>
    </div>

    <!-- Interactive Workflow Selector Tabs -->
    <div class="workbench-tabs" role="tablist" aria-label="Vault workflow demonstrations">
      {workflows.map((wf, index) => (
        <button
          type="button"
          role="tab"
          class:list={['workbench-tab', { 'is-active': index === 0 }]}
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`wf-panel-${wf.id}`}
          id={`wf-tab-${wf.id}`}
          data-wf-target={wf.id}
        >
          <span class="tab-num">{wf.num}</span>
          <strong class="tab-label">{wf.label}</strong>
          <small class="tab-file">{wf.file}</small>
        </button>
      ))}
    </div>

    <!-- 3-Pane Application Blueprint Frame -->
    <div class="app-blueprint-frame">
      <div class="blueprint-titlebar">
        <div class="window-dots" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="window-path mono-label">~/Vaults/Codex-Atlanticus — Tauri v2 (8.4 MB · WAL SQLite)</div>
        <div class="window-status mono-label">● SYNCTHING: 1 PEER CONNECTED</div>
      </div>

      <div class="blueprint-panes">
        <!-- Left Pane: Virtualized File Tree -->
        <aside class="pane-file-tree" aria-label="Vault file tree preview">
          <div class="pane-header mono-label">FILES · 5,000 NOTES</div>
          <ul class="tree-list mono-label">
            <li class="tree-folder">▼ research/</li>
            <li class="tree-item is-active" data-tree-wf="research">▤ On Fleeting Ideas.md</li>
            <li class="tree-item">▤ Anatomia Mentis.md</li>
            <li class="tree-folder">▼ daily/</li>
            <li class="tree-item" data-tree-wf="calendar">📅 2026-10-18.md</li>
            <li class="tree-folder">▼ systems/</li>
            <li class="tree-item" data-tree-wf="sync">⇄ Vault Sync Topology.md</li>
            <li class="tree-folder">▼ boards/</li>
            <li class="tree-item" data-tree-wf="canvas">◫ De Divina Proportione.canvas</li>
          </ul>
          <div class="pane-footer mono-label">
            <span>FTS5 Index: 0.8ms</span>
          </div>
        </aside>

        <!-- Center Pane: CodeMirror 6 Live Preview Panels -->
        <div class="pane-editor">
          {workflows.map((wf, index) => (
            <div
              id={`wf-panel-${wf.id}`}
              role="tabpanel"
              aria-labelledby={`wf-tab-${wf.id}`}
              class:list={['editor-panel', { 'is-active': index === 0 }]}
              data-wf-panel={wf.id}
            >
              <div class="editor-breadcrumb mono-label">{wf.file}</div>
              <pre class="editor-frontmatter mono-label">---{"\n"}{wf.frontmatter}{"\n"}---</pre>
              <h3 class="editor-h1">{wf.title}</h3>
              <div class="editor-body">{wf.body}</div>
            </div>
          ))}
        </div>

        <!-- Right Pane: Local Graph & Backlinks Inspector -->
        <aside class="pane-backlinks" aria-label="Local graph and backlinks">
          <div class="pane-header mono-label">LOCAL GRAPH & BACKLINKS</div>
          <div class="mini-graph-box" aria-hidden="true">
            <svg viewBox="0 0 220 130" class="mini-graph-svg">
              <line x1="110" y1="65" x2="45" y2="30" stroke="var(--accent-terracotta)" stroke-width="1.2" />
              <line x1="110" y1="65" x2="178" y2="36" stroke="var(--accent-terracotta)" stroke-width="1.2" />
              <line x1="110" y1="65" x2="62" y2="104" stroke="var(--border-strong)" stroke-width="1" />
