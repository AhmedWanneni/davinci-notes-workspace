---
import './WhatYouCanDoSection.css';

const capabilities = [
  {
    icon: 'doc',
    title: 'Plain Files on Your Device',
    body: 'Your notes are saved as ordinary files on your computer. You own them forever, with zero risk of lock-in.',
    badge: 'Standard Markdown (.md)',
  },
  {
    icon: 'link',
    title: 'Bi-Directional Linking',
    body: 'Connect ideas using simple brackets. DaVinci automatically links both notes together in both directions.',
    badge: 'Two-way connections',
  },
  {
    icon: 'graph',
    title: 'Interactive Knowledge Graph',
    body: 'Visualize your entire library as an interconnected network. See clusters, themes, and emergent patterns.',
    badge: 'Visual map of thoughts',
  },
  {
    icon: 'canvas',
    title: 'Infinite Visual Canvas',
    body: 'Spread your notes, cards, and diagrams across an infinite spatial board. Group and connect ideas freely.',
    badge: 'Spatial brainstorming',
  },
  {
    icon: 'search',
    title: 'Instant Search & Tags',
    body: 'Find any sentence or #tag across your whole library in milliseconds. Fast search keeps you in flow.',
    badge: 'Real-time library search',
  },
  {
    icon: 'sync',
    title: 'Direct Private Sync',
    body: 'Sync notes directly between your computer and mobile phone. No subscription fees, and no third-party servers.',
    badge: 'Private device-to-device',
  },
];
---

<section class="features-grid-section" id="features" aria-labelledby="features-heading">
  <div class="logseq-container">
    <div class="features-header">
      <div class="features-kicker">Built For Thought</div>
      <h2 id="features-heading" class="features-title">What You Can Do</h2>
      <p class="features-lead">
        A complete set of tools designed to help you capture, connect, and understand your thinking.
      </p>
    </div>

    <div class="features-grid">
      {capabilities.map((item) => (
        <article class="feature-card">
          <div class="feature-card-icon" aria-hidden="true">
            {item.icon === 'doc' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
              </svg>
            )}
            {item.icon === 'link' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
              </svg>
            )}
            {item.icon === 'graph' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="18" cy="5" r="3"></circle>
                <circle cx="6" cy="12" r="3"></circle>
                <circle cx="18" cy="19" r="3"></circle>
                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
              </svg>
            )}
            {item.icon === 'canvas' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="3" y1="9" x2="21" y2="9"></line>
                <line x1="9" y1="21" x2="9" y2="9"></line>
              </svg>
            )}
            {item.icon === 'search' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                <line x1="11" y1="8" x2="11" y2="8.01"></line>
              </svg>
            )}
            {item.icon === 'sync' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <polyline points="1 20 1 14 7 14"></polyline>
                <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
              </svg>
            )}
          </div>
          <h3 class="feature-card-heading">{item.title}</h3>
          <p class="feature-card-body">{item.body}</p>
          <div class="feature-card-badge">✦ {item.badge}</div>
        </article>
      ))}
    </div>
  </div>
</section>
