---
interface Props {
  formulaId: 'euler' | 'fourier' | 'gradient';
}

const { formulaId } = Astro.props;
---

{formulaId === 'euler' && (
  <svg
    class="math-svg"
    viewBox="0 0 148 38"
    role="img"
    aria-label="Euler's Identity: e to the power of i pi plus 1 equals 0"
  >
    <text x="6" y="27" font-family="Georgia, 'Cormorant Garamond', serif" font-size="22" font-style="italic" fill="currentColor">e</text>
    <text x="19" y="15" font-family="Georgia, 'Cormorant Garamond', serif" font-size="13" font-style="italic" fill="var(--accent-terracotta)">iπ</text>
    <text x="40" y="27" font-family="'IBM Plex Mono', monospace" font-size="18" fill="currentColor">+</text>
    <text x="60" y="27" font-family="Georgia, 'Cormorant Garamond', serif" font-size="21" fill="currentColor">1</text>
    <text x="80" y="27" font-family="'IBM Plex Mono', monospace" font-size="18" fill="currentColor">=</text>
    <text x="102" y="27" font-family="Georgia, 'Cormorant Garamond', serif" font-size="21" fill="currentColor">0</text>
    <line x1="124" y1="8" x2="124" y2="30" stroke="var(--border-hairline)" stroke-width="1" />
    <text x="130" y="23" font-family="'IBM Plex Mono', monospace" font-size="9" fill="var(--text-muted)">§1</text>
  </svg>
)}

{formulaId === 'fourier' && (
  <svg
    class="math-svg"
    viewBox="0 0 208 44"
    role="img"
    aria-label="Fourier Transform integral formula"
  >
    <text x="6" y="28" font-family="Georgia, 'Cormorant Garamond', serif" font-size="19" font-style="italic" fill="currentColor">f̂(ξ)</text>
    <text x="44" y="28" font-family="'IBM Plex Mono', monospace" font-size="15" fill="currentColor">=</text>
    <!-- Integral Sign -->
    <path d="M68 35 C71 35, 72 31, 73 22 C74 13, 75 9, 78 9" stroke="var(--accent-terracotta)" stroke-width="1.8" fill="none" stroke-linecap="round" />
    <text x="61" y="41" font-family="'IBM Plex Mono', monospace" font-size="8" fill="var(--text-muted)">-∞</text>
    <text x="77" y="11" font-family="'IBM Plex Mono', monospace" font-size="8" fill="var(--text-muted)">+∞</text>
    <text x="90" y="28" font-family="Georgia, 'Cormorant Garamond', serif" font-size="18" font-style="italic" fill="currentColor">f(x)e</text>
    <text x="132" y="16" font-family="Georgia, 'Cormorant Garamond', serif" font-size="11" font-style="italic" fill="var(--accent-terracotta)">−2πixξ</text>
    <text x="174" y="28" font-family="Georgia, 'Cormorant Garamond', serif" font-size="17" font-style="italic" fill="currentColor">dx</text>
  </svg>
)}

{formulaId === 'gradient' && (
  <svg
    class="math-svg"
    viewBox="0 0 156 38"
    role="img"
    aria-label="Harmonic field divergence formula: nabla squared phi equals zero"
  >
    <!-- Nabla Triangle -->
    <polygon points="8,11 22,11 15,26" fill="none" stroke="var(--accent-terracotta)" stroke-width="1.6" />
    <text x="25" y="15" font-family="'IBM Plex Mono', monospace" font-size="11" fill="var(--accent-terracotta)">2</text>
    <text x="36" y="26" font-family="Georgia, 'Cormorant Garamond', serif" font-size="21" font-style="italic" fill="currentColor">ψ</text>
    <text x="56" y="26" font-family="'IBM Plex Mono', monospace" font-size="16" fill="currentColor">−</text>
    <text x="74" y="26" font-family="Georgia, 'Cormorant Garamond', serif" font-size="19" font-style="italic" fill="currentColor">∂²ψ/∂t²</text>
    <text x="138" y="26" font-family="'IBM Plex Mono', monospace" font-size="13" fill="var(--text-muted)">=0</text>
  </svg>
)}
