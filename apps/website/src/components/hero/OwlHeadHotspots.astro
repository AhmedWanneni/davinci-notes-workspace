---
---

<!-- ==================== OWL HEAD EXTRACTABLE ITEMS & HOTSPOTS ==================== -->
<div class="owl-head-overlay" aria-label="Interactive items inside the owl's head — drag any note, pen, or alarm clock out onto the canvas">
  <div class="hero-interactive-bar">
    <span class="hero-interactive-hint">✋ DRAG ANY NOTE OR ALARM — OR PULL THOUGHTS FROM THE OWL'S HEAD</span>
    <button type="button" class="hero-reset-desk-btn" id="hero-reset-desk" hidden>
      ↺ RESET DESK
    </button>
  </div>

  <!-- 1. Terracotta Brain / Mind Graph Note (Upper Left of Head) -->
  <div class="owl-scrap owl-scrap-terracotta owl-head-extractable head-item-brain" data-draggable-hero data-from-head="true" data-rot="-9" role="button" tabindex="0">
    <svg class="scrap-doodle-svg" viewBox="0 0 88 58" fill="none" aria-hidden="true">
      <g stroke="#331d0e" stroke-width="1.8" stroke-linecap="round">
        <line x1="10" y1="28" x2="16" y2="28"/><line x1="72" y1="28" x2="78" y2="28"/>
        <line x1="16" y1="12" x2="21" y2="16"/><line x1="72" y1="12" x2="67" y2="16"/>
        <line x1="22" y1="45" x2="26" y2="40"/><line x1="66" y1="45" x2="62" y2="40"/>
      </g>
      <path d="M27 32 C19 30, 18 19, 26 17 C28 10, 40 9, 44 15 C48 9, 60 10, 62 17 C70 19, 69 30, 61 32 C62 40, 50 44, 44 39 C38 44, 26 40, 27 32 Z" stroke="#331d0e" stroke-width="2" fill="#b86c45"/>
      <path d="M44 15 L44 39 M32 23 C36 21, 39 25, 39 29 M56 23 C52 21, 49 25, 49 29" stroke="#331d0e" stroke-width="1.7" stroke-linecap="round"/>
    </svg>
    <div class="scrap-title-sm">MIND GRAPH</div>
  </div>

  <!-- 2. Spiral "NOTES: PLAN · FOCUS · PRIORITIZE · EXECUTE" Pad (Top Center-Left) -->
  <div class="owl-scrap owl-scrap-head-notes owl-head-extractable head-item-notes" data-draggable-hero data-from-head="true" data-rot="-7" role="button" tabindex="0">
    <div class="head-spiral-top" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="scrap-heading-block">
      <span>NOTES</span>
      <svg class="hand-underline-svg" viewBox="0 0 70 6" fill="none"><path d="M2 3 L68 2.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/></svg>
    </div>
    <ul class="head-mini-list">
      <li><span class="ink-dot"></span>PLAN</li>
      <li><span class="ink-dot"></span>FOCUS</li>
      <li><span class="ink-dot"></span>PRIORITIZE</li>
      <li><span class="ink-dot"></span><span class="hand-oval-inline">EXECUTE</span></li>
    </ul>
  </div>

  <!-- 3. Mustard "REMINDER: FOCUS ON WHAT MATTERS" Sticky (Mid-Left of Head) -->
  <div class="owl-scrap owl-scrap-mustard owl-head-extractable head-item-focus" data-draggable-hero data-from-head="true" data-rot="-12" role="button" tabindex="0">
    <div class="scrap-heading-block">
      <span>REMINDER:</span>
      <svg class="hand-underline-svg" viewBox="0 0 90 6" fill="none"><path d="M2 3 L88 2.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/></svg>
    </div>
    <div class="scrap-mustard-body">
      <span>FOCUS ON</span>
      <span>WHAT</span>
      <span>MATTERS</span>
    </div>
    <svg class="hand-bottom-strokes" viewBox="0 0 84 7" fill="none"><path d="M2 2.5 L82 2 M14 5.5 L68 5" stroke="#331d0e" stroke-width="1.9" stroke-linecap="round"/></svg>
  </div>

  <!-- 4. Terracotta Binder-Clipped "ALARM 7:00 AM" Note (Upper Right of Head) -->
  <div class="owl-scrap owl-scrap-terracotta owl-head-extractable head-item-alarm-note" data-draggable-hero data-from-head="true" data-rot="13" role="button" tabindex="0">
    <div class="scrap-heading-block">
      <span>ALARM</span>
      <svg class="hand-underline-svg" viewBox="0 0 68 6" fill="none"><path d="M2 3 L66 2.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/></svg>
    </div>
    <svg class="head-bell-svg" viewBox="0 0 48 34" fill="none" aria-hidden="true">
      <path d="M6 16 L10 18 M6 22 L11 22 M42 16 L38 18 M42 22 L37 22" stroke="#331d0e" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M24 5 C18 5, 16 11, 15 21 L12 24 L36 24 L33 21 C32 11, 30 5, 24 5 Z" stroke="#331d0e" stroke-width="2" fill="none" stroke-linejoin="round"/>
      <circle cx="24" cy="26.5" r="2.2" fill="#331d0e"/>
    </svg>
    <div class="scrap-title-sm">7:00 AM</div>
  </div>

  <!-- 5. Mustard Exclamation "!" Note (Positioned on Upper-Right Corner of GET THE APP Card by Default) -->
  <div class="owl-scrap owl-scrap-mustard head-item-exclaim" data-draggable-hero data-rot="15" role="button" tabindex="0">
    <svg class="head-exclaim-svg" viewBox="0 0 54 52" fill="none" aria-hidden="true">
      <g stroke="#331d0e" stroke-width="1.8" stroke-linecap="round">
        <line x1="10" y1="12" x2="15" y2="16"/><line x1="44" y1="12" x2="39" y2="16"/>
        <line x1="7" y1="26" x2="13" y2="26"/><line x1="47" y1="26" x2="41" y2="26"/>
        <line x1="11" y1="40" x2="16" y2="36"/><line x1="43" y1="40" x2="38" y2="36"/>
      </g>
      <rect x="24" y="8" width="6" height="23" rx="3" fill="#331d0e"/>
      <circle cx="27" cy="39" r="3.4" fill="#331d0e"/>
    </svg>
  </div>

  <!-- 6. Spiral "TO DO: REPORT · EMAILS · CALLS · FOLLOW UP" Pad (Center-Right of Head) -->
  <div class="owl-scrap owl-scrap-todo owl-head-extractable head-item-todo" data-draggable-hero data-from-head="true" data-rot="14" role="button" tabindex="0">
    <div class="scrap-todo-rings" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="scrap-todo-content">
      <div class="scrap-todo-head">
        <span class="scrap-heading-block">
          <span>TO DO:</span>
          <svg class="hand-underline-svg" viewBox="0 0 64 6" fill="none"><path d="M2 3 L62 2.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/></svg>
        </span>
      </div>
      <ul class="head-mini-list">
        <li>☑ REPORT</li>
        <li>☑ EMAILS</li>
        <li>☑ CALLS</li>
        <li>☑ FOLLOW UP</li>
      </ul>
    </div>
  </div>

  <!-- 7. Dusty Slate-Blue "№ 77 BUS TICKET 45290" Stub (Peeking from Far-Left Edge by Default) -->
  <div class="owl-scrap owl-scrap-ticket head-item-ticket" data-draggable-hero data-rot="16" role="button" tabindex="0">
    <div class="ticket-inner-frame">
      <div class="ticket-no">№ 77</div>
      <div class="ticket-dots">·······</div>
      <svg class="ticket-bus-svg" viewBox="0 0 36 20" fill="none" aria-hidden="true">
        <rect x="4" y="3" width="28" height="12" rx="2.5" fill="#384f62"/>
        <rect x="7" y="5" width="5" height="4" rx="0.8" fill="#fffdf8"/>
        <rect x="14" y="5" width="5" height="4" rx="0.8" fill="#fffdf8"/>
        <rect x="21" y="5" width="5" height="4" rx="0.8" fill="#fffdf8"/>
        <circle cx="10" cy="16" r="2.4" fill="#22160d"/><circle cx="26" cy="16" r="2.4" fill="#22160d"/>
      </svg>
      <div class="ticket-label">BUS TICKET</div>
      <div class="ticket-code">45290</div>
    </div>
  </div>

  <!-- 8. Center Twin-Bell Alarm Clock Inside the Owl's Head -->
  <div class="owl-scrap owl-scrap-head-clock owl-head-extractable head-item-clock" data-draggable-hero data-from-head="true" data-rot="-5" role="button" tabindex="0">
    <div class="head-clock-badge">⏰ 12:10</div>
    <div class="scrap-title-sm">DEEP WORK TIMER</div>
  </div>

  <!-- 9. Dark Slate "MEETING 10 AM" Sticky (Bottom-Center of Head) -->
  <div class="owl-scrap owl-scrap-slate owl-head-extractable head-item-meeting" data-draggable-hero data-from-head="true" data-rot="-4" role="button" tabindex="0">
    <div class="scrap-title-sm">MEETING</div>
    <div class="scrap-title-sm">10 AM</div>
    <svg class="hand-bottom-strokes" viewBox="0 0 74 7" fill="none"><path d="M4 2.5 L70 2 M14 5.5 L58 5" stroke="#22180e" stroke-width="1.9" stroke-linecap="round"/></svg>
  </div>

  <!-- 10. Mustard "IMPORTANT! ☆" Sticky (Peeking from Far-Right Edge by Default) -->
  <div class="owl-scrap owl-scrap-mustard head-item-important" data-draggable-hero data-rot="-12" role="button" tabindex="0">
    <div class="scrap-title-sm">IMPORTANT! ☆</div>
    <svg class="hand-bottom-strokes" viewBox="0 0 92 7" fill="none"><path d="M4 2.5 L88 2 M16 5.5 L74 5" stroke="#331d0e" stroke-width="1.9" stroke-linecap="round"/></svg>
  </div>

  <!-- 11. Olive "BUY: COFFEE · PENS · PAPER" Card (Lower Right of Head) -->
  <div class="owl-scrap owl-scrap-olive owl-head-extractable head-item-buy" data-draggable-hero data-from-head="true" data-rot="16" role="button" tabindex="0">
    <div class="scrap-olive-title">BUY:</div>
    <ul class="head-mini-list">
      <li><span class="ink-dot"></span>COFFEE</li>
      <li><span class="ink-dot"></span>PENS</li>
      <li><span class="ink-dot"></span>PAPER</li>
    </ul>
  </div>
</div>
