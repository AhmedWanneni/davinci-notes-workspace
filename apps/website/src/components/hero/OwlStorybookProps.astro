<!-- ==================== COZY STORYBOOK DESK PROPS (DRAGGABLE) ==================== -->

<!-- L-Storybook Prop: Cozy Steaming Dusty-Rose Mug (Inspired by the Tomke & Jona Bear Illustration) -->
<div class="bottom-svg-item bottom-item-mug" data-draggable-hero data-rot="6" title="Drag cozy bear tea mug">
  <svg viewBox="0 0 124 138" fill="none">
    <!-- Rising Warm Heart-Shaped Steam (Like the Bear Illustration) -->
    <g class="storybook-steam-curls">
      <!-- Heart Steam Puff -->
      <path d="M42 22 C34 10, 48 2, 54 10 C60 2, 74 10, 66 22 C60 30, 54 34, 54 34 C54 34, 48 30, 42 22 Z" fill="#f4e3ca" opacity="0.65" stroke="#392b2a" stroke-width="1.3" />
      <path d="M54 34 C52 42, 56 46, 54 50" stroke="#f4e3ca" stroke-width="2.5" stroke-linecap="round" opacity="0.6" />
    </g>
    <!-- Mug Handle -->
    <path d="M88 56 C108 56, 110 92, 86 94" stroke="#392b2a" stroke-width="9" stroke-linecap="round" fill="none" />
    <path d="M88 56 C106 56, 108 92, 86 94" stroke="#bd625d" stroke-width="5.5" stroke-linecap="round" fill="none" />
