    <g fill="#f4e3ca" stroke="#392b2a" stroke-width="1.2">
      <!-- Top Row Chevron / Heart Stitches -->
      <path d="M38 72 L42 66 L46 72" stroke="#392b2a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path d="M48 72 L52 66 L56 72" stroke="#392b2a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path d="M58 72 L62 66 L66 72" stroke="#392b2a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      <path d="M68 72 L72 66 L76 72" stroke="#392b2a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none" />
