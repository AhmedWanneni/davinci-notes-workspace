      <path d="M44 88 C44 88, 39 84, 39 81 C39 79, 41 78, 42.5 78 C43.5 78, 44 79, 44 79 C44 79, 44.5 78, 45.5 78 C47 78, 49 79, 49 81 C49 84, 44 88, 44 88 Z" fill="#ac4e32" />
