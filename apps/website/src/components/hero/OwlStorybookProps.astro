      <path d="M72 88 C72 88, 67 84, 67 81 C67 79, 69 78, 70.5 78 C71.5 78, 72 79, 72 79 C72 79, 72.5 78, 73.5 78 C75 78, 77 79, 77 81 C77 84, 72 88, 72 88 Z" fill="#ac4e32" />
