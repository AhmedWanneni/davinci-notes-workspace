---
import OwlBottomItems from './OwlBottomItems.astro';
---

<!-- Subtle Hand-Drawn Ink Trail Curves with Generous Negative Space -->
<svg class="owl-notes-trails" viewBox="0 0 1400 740" fill="none" aria-hidden="true">
  <!-- Left gentle dashed ink curves -->
  <path d="M 435 230 C 380 210, 340 210, 295 225" stroke="#3a2615" stroke-width="1.4" stroke-dasharray="5 6" stroke-linecap="round" opacity="0.32" />
  <path d="M 390 480 C 335 485, 290 495, 245 510" stroke="#3a2615" stroke-width="1.4" stroke-dasharray="5 6" stroke-linecap="round" opacity="0.28" />
  <!-- Right gentle dashed ink curves -->
  <path d="M 965 230 C 1020 210, 1060 210, 1105 225" stroke="#3a2615" stroke-width="1.4" stroke-dasharray="5 6" stroke-linecap="round" opacity="0.32" />
  <path d="M 1010 480 C 1065 485, 1110 495, 1155 510" stroke="#3a2615" stroke-width="1.4" stroke-dasharray="5 6" stroke-linecap="round" opacity="0.28" />

  <!-- Subtle floating hand-drawn stars -->
  <path d="M 345 335 L 348 343 L 357 343 L 350 348 L 352 357 L 345 352 L 338 357 L 340 348 L 333 343 L 342 343 Z" stroke="#2c1d10" stroke-width="1.4" fill="#c38b32" opacity="0.75" />
  <path d="M 1055 335 L 1058 343 L 1067 343 L 1060 348 L 1062 357 L 1055 352 L 1048 357 L 1050 348 L 1043 343 L 1052 343 Z" stroke="#2c1d10" stroke-width="1.4" fill="#b56b45" opacity="0.75" />
</svg>

<!-- ==================== LEFT SIDE NOTES ==================== -->
<div class="owl-side-notes owl-side-notes-left">
  <!-- Note L1: Upper-Left Realistic Spiral Manifesto Pad (Matching Owl's "NOTES" Pad) -->
  <div class="owl-scrap owl-scrap-manifesto scrap-l-main" data-draggable-hero data-rot="-2.5">
    <svg class="spiral-rings-top" viewBox="0 0 228 28" fill="none" aria-hidden="true">
      <g>
        <rect x="20" y="15" width="7" height="7" rx="1.5" fill="#594736"/>
        <path d="M22 19 C20 3, 28 3, 26 19" stroke="#3b2614" stroke-width="3" stroke-linecap="round"/>
        <rect x="52" y="15" width="7" height="7" rx="1.5" fill="#594736"/>
        <path d="M54 19 C52 3, 60 3, 58 19" stroke="#3b2614" stroke-width="3" stroke-linecap="round"/>
        <rect x="84" y="15" width="7" height="7" rx="1.5" fill="#594736"/>
        <path d="M86 19 C84 3, 92 3, 90 19" stroke="#3b2614" stroke-width="3" stroke-linecap="round"/>
        <rect x="116" y="15" width="7" height="7" rx="1.5" fill="#594736"/>
        <path d="M118 19 C116 3, 124 3, 122 19" stroke="#3b2614" stroke-width="3" stroke-linecap="round"/>
        <rect x="148" y="15" width="7" height="7" rx="1.5" fill="#594736"/>
        <path d="M150 19 C148 3, 156 3, 154 19" stroke="#3b2614" stroke-width="3" stroke-linecap="round"/>
        <rect x="180" y="15" width="7" height="7" rx="1.5" fill="#594736"/>
        <path d="M182 19 C180 3, 188 3, 186 19" stroke="#3b2614" stroke-width="3" stroke-linecap="round"/>
      </g>
    </svg>
    <div class="manifesto-head-row">
      <span class="scrap-heading-underlined">
        SOPHIA NOTES
        <svg class="hand-underline-svg" viewBox="0 0 130 8" fill="none" aria-hidden="true">
          <path d="M2 3.5 C42 1.5, 88 2.5, 128 3 M12 6.5 C50 5.5, 84 6, 114 6.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </span>
      <svg class="hand-star-svg" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <path d="M14 2 L17 10 L25 10 L19 15 L21 23 L14 18 L7 23 L9 15 L3 10 L11 10 Z" stroke="#331d0e" stroke-width="1.9" fill="#c38b32" stroke-linejoin="round"/>
      </svg>
    </div>
    <p class="manifesto-hand-lead">
      EVERY THOUGHT IN YOUR HEAD,
      <span class="hand-oval-wrap">
        ORGANIZED
        <svg class="hand-oval-svg" viewBox="0 0 116 34" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <path d="M5 18 C3 5, 111 3, 113 17 C114 29, 7 31, 4 18 C3 12, 22 6, 48 5" stroke="#331d0e" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </span>
      IN ONE PLACE.
    </p>
    <ul class="scrap-bullets">
      <li><span class="ink-dot"></span>LOCAL MARKDOWN FILES</li>
      <li><span class="ink-dot"></span>[[WIKILINKS]] &amp; GRAPH</li>
    </ul>
  </div>

  <!-- Note L2: Mid-Left Realistic Ochre Sticky Note (Matching Owl's "REMINDER: FOCUS ON WHAT MATTERS") -->
  <div class="owl-scrap owl-scrap-mustard scrap-l-mustard" data-draggable-hero data-rot="4" role="button" tabindex="0">
    <div class="scrap-heading-block">
      <span>REMINDER:</span>
      <svg class="hand-underline-svg" viewBox="0 0 100 8" fill="none" aria-hidden="true">
        <path d="M2 3 C34 1.5, 68 2, 98 3 M8 6.5 C36 5.5, 66 5.5, 88 6.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="scrap-mustard-body">
      <span>100% OFFLINE</span>
      <span>&amp; PRIVATE VAULT</span>
    </div>
    <svg class="hand-bottom-strokes" viewBox="0 0 92 8" fill="none" aria-hidden="true">
      <path d="M4 2.5 L88 2 M18 6 L72 5.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <svg class="scrap-star-doodle" viewBox="0 0 28 28" fill="none" aria-hidden="true">
      <path d="M14 2 L17 10 L25 10 L19 15 L21 23 L14 18 L7 23 L9 15 L3 10 L11 10 Z" stroke="#331d0e" stroke-width="2" stroke-linejoin="round"/>
    </svg>
  </div>
</div>

<!-- ==================== RIGHT SIDE NOTES ==================== -->
<div class="owl-side-notes owl-side-notes-right">
  <!-- Note R1: Upper-Right Realistic Binder-Clipped App Download Card (Matching Owl's "ALARM" Clip Card) -->
  <div class="owl-scrap owl-scrap-cta-sheet scrap-r-main" data-draggable-hero data-rot="2.5">
    <svg class="binder-clip-svg" viewBox="0 0 64 54" fill="none" aria-hidden="true">
      <!-- Wire Loops -->
      <path d="M23 24 L17 7 C15 2, 26 1, 28 7 L30 24 M41 24 L47 7 C49 2, 38 1, 36 7 L34 24" stroke="#3d352e" stroke-width="2.6" stroke-linecap="round"/>
      <!-- Binder Clip Cast Shadow on Card -->
      <path d="M12 25 L54 25 L57 45 L9 45 Z" fill="rgba(40, 22, 10, 0.22)"/>
      <!-- Dark Charcoal Metal Body with Painterly Highlight -->
      <path d="M12 22 L52 22 L55 41 L9 41 Z" fill="#3b3632"/>
      <path d="M12 22 L52 22 L53 27 L11 27 Z" fill="#524b45"/>
      <rect x="14" y="38" width="11" height="4.5" rx="1.5" fill="#292522"/>
      <rect x="39" y="38" width="11" height="4.5" rx="1.5" fill="#292522"/>
    </svg>
    <div class="cta-sheet-head">
      <span class="scrap-heading-block">
        <span>GET THE APP:</span>
        <svg class="hand-underline-svg" viewBox="0 0 112 8" fill="none" aria-hidden="true">
          <path d="M2 3 C38 1.5, 76 2, 110 3 M12 6.5 C44 5.5, 76 5.5, 98 6.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </span>
      <span class="cta-version-tag">FREE v1.0</span>
    </div>
    <div class="cta-sheet-buttons">
      <a
        href="https://github.com/AhmedWanneni/davinci-notes-workspace/releases/latest/download/Sophia_0.1.0_aarch64.dmg"
        class="cta-hand-btn cta-hand-btn-primary"
        data-laptop-download-btn
      >
        <span class="cta-btn-text">↓ DOWNLOAD FOR MAC (.DMG)</span>
      </a>
      <a href="#workbench" class="cta-hand-btn cta-hand-btn-secondary">
        <span>TRY INTERACTIVE DEMO ↓</span>
      </a>
    </div>
    <div class="cta-sheet-platforms" data-laptop-platforms>
      <span>Mac (Apple Silicon & Intel)</span><br />
      <span class="platform-alt-row">
        Also for:
        <a href="https://github.com/AhmedWanneni/davinci-notes-workspace/releases/latest/download/Sophia_0.1.0_x64-setup.exe" class="platform-quick-link">Windows .exe</a> ·
        <a href="https://github.com/AhmedWanneni/davinci-notes-workspace/releases/latest/download/sophia_0.1.0_amd64.AppImage" class="platform-quick-link">Linux</a> ·
        <a href="/download" class="platform-quick-link">All ↗</a>
      </span>
    </div>
  </div>

  <!-- Note R2: Mid-Right Realistic Side-Bound Spiral "INCLUDED" Checklist (Matching Owl's "TO DO:" Pad) -->
  <div class="owl-scrap owl-scrap-todo scrap-r-todo" data-draggable-hero data-rot="-4" role="button" tabindex="0">
    <svg class="side-spiral-svg" viewBox="0 0 22 136" fill="none" aria-hidden="true">
      <g>
        <rect x="11" y="10" width="6" height="6" rx="1" fill="#4f3d2c"/><path d="M2 11 L15 11 M2 15 L15 15" stroke="#382514" stroke-width="2.2" stroke-linecap="round"/>
        <rect x="11" y="31" width="6" height="6" rx="1" fill="#4f3d2c"/><path d="M2 32 L15 32 M2 36 L15 36" stroke="#382514" stroke-width="2.2" stroke-linecap="round"/>
        <rect x="11" y="52" width="6" height="6" rx="1" fill="#4f3d2c"/><path d="M2 53 L15 53 M2 57 L15 57" stroke="#382514" stroke-width="2.2" stroke-linecap="round"/>
        <rect x="11" y="73" width="6" height="6" rx="1" fill="#4f3d2c"/><path d="M2 74 L15 74 M2 78 L15 78" stroke="#382514" stroke-width="2.2" stroke-linecap="round"/>
        <rect x="11" y="94" width="6" height="6" rx="1" fill="#4f3d2c"/><path d="M2 95 L15 95 M2 99 L15 99" stroke="#382514" stroke-width="2.2" stroke-linecap="round"/>
        <rect x="11" y="115" width="6" height="6" rx="1" fill="#4f3d2c"/><path d="M2 116 L15 116 M2 120 L15 120" stroke="#382514" stroke-width="2.2" stroke-linecap="round"/>
      </g>
    </svg>
    <div class="scrap-todo-content">
      <div class="scrap-todo-head">
        <span class="scrap-heading-block">
          <span>INCLUDED:</span>
          <svg class="hand-underline-svg" viewBox="0 0 90 7" fill="none" aria-hidden="true">
            <path d="M2 3.5 C30 2, 62 2.5, 88 3.5" stroke="#331d0e" stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
        <svg class="hand-star-svg" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <path d="M14 2 L17 10 L25 10 L19 15 L21 23 L14 18 L7 23 L9 15 L3 10 L11 10 Z" stroke="#331d0e" stroke-width="2" stroke-linejoin="round"/>
        </svg>
      </div>
      <ul class="scrap-todo-list">
        <li>
          <svg class="hand-check-svg" viewBox="0 0 18 18" fill="none"><rect x="2" y="3" width="12" height="12" rx="1.5" stroke="#331d0e" stroke-width="1.8"/><path d="M5 9 L8 12.5 L15.5 3.5" stroke="#331d0e" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>DAILY JOURNAL</span>
        </li>
        <li>
          <svg class="hand-check-svg" viewBox="0 0 18 18" fill="none"><rect x="2" y="3" width="12" height="12" rx="1.5" stroke="#331d0e" stroke-width="1.8"/><path d="M5 9 L8 12.5 L15.5 3.5" stroke="#331d0e" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>2D JSON CANVAS</span>
        </li>
        <li>
          <svg class="hand-check-svg" viewBox="0 0 18 18" fill="none"><rect x="2" y="3" width="12" height="12" rx="1.5" stroke="#331d0e" stroke-width="1.8"/><path d="M5 9 L8 12.5 L15.5 3.5" stroke="#331d0e" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>P2P DEVICE SYNC</span>
        </li>
      </ul>
    </div>
  </div>
</div>

<OwlBottomItems />
