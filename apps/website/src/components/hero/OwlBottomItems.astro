---
---

<!-- ==================== BOTTOM HALF-SHOWN DESK & MIND ITEMS ==================== -->
<div class="owl-bottom-items" aria-hidden="true">
  <!-- ==================== LEFT SCATTERED CLUSTER ==================== -->
  <div class="owl-bottom-cluster owl-bottom-left">
    <!-- L-Corner: Static Pens Peeking in the Far Bottom-Left Corner (Non-Draggable) -->
    <div class="bottom-svg-item bottom-item-left-pens">
      <svg viewBox="0 0 130 160" fill="none">
        <!-- Warm Rust Clicker Pen (matching upper-left pen in owl head) -->
        <g transform="rotate(-19 42 90)">
          <rect x="36" y="8" width="12" height="18" rx="5" fill="#70695f" />
          <path d="M36 13 C36 8, 48 8, 48 13" fill="#827b70" />
          <rect x="31" y="23" width="22" height="12" rx="2.5" fill="#783015" />
          <path d="M31 31 L22 36 C19 38, 19 43, 21 48 L29 94 L33 93 L25 45 L31 39 Z" fill="#5e240f" />
          <rect x="28" y="33" width="28" height="118" rx="3" fill="#8c3919" />
          <rect x="28" y="33" width="9" height="118" rx="2" fill="#9e4320" opacity="0.7" />
          <rect x="47" y="33" width="9" height="118" rx="2" fill="#6b2910" opacity="0.65" />
        </g>

        <!-- Charcoal Gel Pen with Textured Grip & Silver Clip -->
        <g transform="rotate(14 88 96)">
          <path d="M84 14 L78 32 L90 32 Z" fill="#7c756b" />
          <path d="M84 14 L82 21 L86 21 Z" fill="#433e38" />
          <rect x="76" y="31" width="16" height="8" rx="2" fill="#968d80" />
          <rect x="73" y="38" width="22" height="44" rx="4" fill="#3d3935" />
          <circle cx="78" cy="46" r="1" fill="#59534d" /><circle cx="84" cy="49" r="1" fill="#59534d" /><circle cx="89" cy="45" r="1" fill="#59534d" />
          <circle cx="77" cy="56" r="1" fill="#59534d" /><circle cx="83" cy="59" r="1" fill="#59534d" /><circle cx="90" cy="55" r="1" fill="#59534d" />
          <circle cx="79" cy="67" r="1" fill="#59534d" /><circle cx="85" cy="70" r="1" fill="#59534d" /><circle cx="89" cy="65" r="1" fill="#59534d" />
          <path d="M73 43 L65 47 L65 88 L69 89 L69 50 L73 47 Z" fill="#9a9083" />
          <rect x="73" y="81" width="22" height="8" fill="#857c70" />
          <rect x="74" y="89" width="20" height="65" fill="#4d3d32" />
          <rect x="87" y="89" width="7" height="65" fill="#3a2d24" opacity="0.7" />
        </g>
      </svg>
    </div>

    <!-- L-Mid: Complete 360° Vintage Twin-Bell Alarm Clock (Full Numerals 1-12 + Brass Feet When Pulled Up) -->
    <div class="bottom-svg-item bottom-item-alarm" data-draggable-hero data-rot="-9" title="Drag alarm clock">
      <svg viewBox="0 0 176 196" fill="none">
        <!-- Bottom Brass/Espresso Peg Feet (Visible When Pulled Up from Bottom Edge) -->
        <path d="M54 156 L42 182 C40 186, 48 189, 51 184 L64 160 Z" fill="#4a1c0a" />
        <ellipse cx="45" cy="185" rx="6" ry="3.5" fill="#331205" />
        <path d="M122 156 L134 182 C136 186, 128 189, 125 184 L112 160 Z" fill="#4a1c0a" />
        <ellipse cx="131" cy="185" rx="6" ry="3.5" fill="#331205" />

        <!-- Curved Rust Handle Connecting the Twin Bells -->
        <path d="M44 42 C46 12, 130 12, 132 42" stroke="#6b2810" stroke-width="7.5" stroke-linecap="round" fill="none" />
        <path d="M44 42 C46 12, 130 12, 132 42" stroke="#8c3718" stroke-width="4.5" stroke-linecap="round" fill="none" />

        <!-- Center Hammer Post & Knob -->
        <rect x="85" y="29" width="6" height="19" fill="#59200c" />
        <rect x="78" y="22" width="20" height="9" rx="4" fill="#823114" />
        <path d="M80 24 L96 24" stroke="#9e4322" stroke-width="2" stroke-linecap="round" />

        <!-- Left Bell Support Post & Tilted Dome -->
        <g transform="rotate(-32 44 50)">
          <rect x="41" y="25" width="6" height="12" rx="2" fill="#6b2810" />
          <rect x="41" y="54" width="6" height="14" fill="#471808" />
          <ellipse cx="44" cy="56" rx="27" ry="6" fill="#3d1406" />
          <path d="M17 56 C17 28, 71 28, 71 56 Z" fill="#8a3517" />
          <path d="M21 54 C22 34, 45 31, 48 33 C36 36, 28 45, 27 54 Z" fill="#a34422" opacity="0.75" />
          <path d="M48 31 C62 34, 69 44, 71 56 L56 56 C56 45, 53 36, 48 31 Z" fill="#69260e" opacity="0.75" />
        </g>

        <!-- Right Bell Support Post & Tilted Dome -->
        <g transform="rotate(32 132 50)">
          <rect x="129" y="25" width="6" height="12" rx="2" fill="#6b2810" />
          <rect x="129" y="54" width="6" height="14" fill="#471808" />
          <ellipse cx="132" cy="56" rx="27" ry="6" fill="#3d1406" />
          <path d="M105 56 C105 28, 159 28, 159 56 Z" fill="#8a3517" />
          <path d="M109 54 C110 34, 133 31, 136 33 C124 36, 116 45, 115 54 Z" fill="#a34422" opacity="0.75" />
          <path d="M136 31 C150 34, 157 44, 159 56 L144 56 C144 45, 141 36, 136 31 Z" fill="#69260e" opacity="0.75" />
        </g>

        <!-- Outer Terracotta Clock Body with Full 360° Rim Shading -->
        <circle cx="88" cy="108" r="58" fill="#6e280f" />
        <circle cx="88" cy="108" r="55" fill="#8f3819" />
        <path d="M36 92 A54 54 0 0 1 138 88" stroke="#a84724" stroke-width="4" fill="none" opacity="0.7" />
        <path d="M40 132 A54 54 0 0 0 136 132" stroke="#59200c" stroke-width="4" fill="none" opacity="0.75" />
        <!-- Inner Recessed Dark Rim -->
        <circle cx="88" cy="108" r="46" fill="#59200c" />
        <!-- Warm Cream Vintage Dial -->
        <circle cx="88" cy="108" r="43" fill="#e6cfa8" />
        <!-- Subtle Inner Shadow Crescent at Top of Dial -->
        <path d="M46 102 A42 42 0 0 1 130 102 A42 40 0 0 0 46 102 Z" fill="#cfb48a" opacity="0.7" />

        <!-- Full 360° Minute & Hour Tick Marks Around the Entire Dial -->
        <g stroke="#3d2412" stroke-width="1.5" stroke-linecap="round" opacity="0.85">
          <line x1="88" y1="67" x2="88" y2="71" /><line x1="88" y1="145" x2="88" y2="149" />
          <line x1="108" y1="72" x2="106" y2="76" /><line x1="68" y1="140" x2="70" y2="144" />
          <line x1="123" y1="87" x2="119" y2="89" /><line x1="53" y1="127" x2="57" y2="129" />
          <line x1="129" y1="108" x2="125" y2="108" /><line x1="47" y1="108" x2="51" y2="108" />
          <line x1="123" y1="129" x2="119" y2="127" /><line x1="53" y1="87" x2="57" y2="89" />
          <line x1="108" y1="144" x2="106" y2="140" /><line x1="68" y1="72" x2="70" y2="76" />
          <line x1="98" y1="68" x2="97" y2="71" /><line x1="116" y1="79" x2="113" y2="82" />
          <line x1="127" y1="97" x2="123" y2="98" /><line x1="127" y1="119" x2="123" y2="118" />
          <line x1="116" y1="137" x2="113" y2="134" /><line x1="98" y1="148" x2="97" y2="145" />
          <line x1="78" y1="148" x2="79" y2="145" /><line x1="60" y1="137" x2="63" y2="134" />
          <line x1="49" y1="119" x2="53" y2="118" /><line x1="49" y1="97" x2="53" y2="98" />
          <line x1="60" y1="79" x2="63" y2="82" /><line x1="78" y1="68" x2="79" y2="71" />
        </g>

        <!-- Complete Hand-Painted Serif Numerals 1 through 12 -->
        <text x="88" y="83" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="13" font-weight="700">12</text>
        <text x="104" y="87" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">1</text>
        <text x="116" y="99" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">2</text>
        <text x="120" y="113" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">3</text>
        <text x="115" y="128" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">4</text>
        <text x="103" y="139" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">5</text>
        <text x="88" y="143" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="13" font-weight="700">6</text>
        <text x="73" y="139" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">7</text>
        <text x="61" y="128" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">8</text>
        <text x="56" y="113" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">9</text>
        <text x="60" y="99" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">10</text>
        <text x="72" y="87" text-anchor="middle" fill="#331d0e" font-family="Georgia, serif" font-size="12.5" font-weight="700">11</text>

        <!-- Vintage Spade Clock Hands & Center Hub -->
        <path d="M88 108 L83 92 L85 83 L88 77 L91 83 L89 92 Z" fill="#3b2210" />
        <path d="M88 108 L103 95 L112 90 L106 99 L91 110 Z" fill="#3b2210" />
        <circle cx="88" cy="108" r="5.5" fill="#4a2b14" />
        <circle cx="88" cy="108" r="2.2" fill="#8f3819" />
      </svg>
    </div>

    <!-- L-Front: Half-Shown Olive "IDEA" Card -->
    <div class="owl-scrap owl-scrap-olive bottom-item-idea" data-draggable-hero data-rot="-14" role="button" tabindex="0">
      <div class="scrap-olive-title">IDEA</div>
      <svg class="scrap-bulb-svg" viewBox="0 0 74 72" fill="none">
        <g stroke="#241c0f" stroke-width="2" stroke-linecap="round">
          <line x1="37" y1="3" x2="37" y2="10"/><line x1="17" y1="9" x2="22" y2="15"/><line x1="57" y1="9" x2="52" y2="15"/>
          <line x1="8" y1="26" x2="15" y2="28"/><line x1="66" y1="26" x2="59" y2="28"/><line x1="12" y1="44" x2="18" y2="41"/><line x1="62" y1="44" x2="56" y2="41"/>
        </g>
        <path d="M26 46 C18 39, 18 22, 37 16 C56 22, 56 39, 48 46 L45 53 L29 53 Z" fill="#e6cfa8" stroke="#241c0f" stroke-width="2.2" stroke-linejoin="round"/>
        <path d="M33 52 L31 38 C29 33, 35 32, 37 36 C39 32, 45 33, 43 38 L41 52" stroke="#241c0f" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="29" y="53" width="16" height="4" rx="1.5" fill="#3a2f1d" stroke="#241c0f" stroke-width="1.6"/>
        <rect x="30" y="57" width="14" height="4" rx="1.5" fill="#3a2f1d" stroke="#241c0f" stroke-width="1.6"/>
        <path d="M33 61 L41 61 L39 65 L35 65 Z" fill="#241c0f"/>
      </svg>
    </div>
  </div>

  <!-- ==================== RIGHT SCATTERED CLUSTER ==================== -->
  <div class="owl-bottom-cluster owl-bottom-right">
    <!-- R-Corner: Static Pen & Pencils Peeking in the Far Bottom-Right Corner (Non-Draggable) -->
    <div class="bottom-svg-item bottom-item-right-pens">
      <svg viewBox="0 0 144 165" fill="none">
        <!-- Ochre/Brass Fineliner Marker Pen -->
        <g transform="rotate(-16 44 90)">
          <path d="M42 10 L37 26 L47 26 Z" fill="#7d5a16" />
          <rect x="34" y="25" width="16" height="16" rx="2" fill="#3a3632" />
          <rect x="30" y="40" width="24" height="68" rx="2" fill="#7c5c1a" />
          <rect x="30" y="40" width="6" height="68" fill="#916d22" opacity="0.65" />
          <rect x="48" y="40" width="6" height="68" fill="#594110" opacity="0.65" />
          <rect x="36" y="46" width="3.5" height="54" rx="1.5" fill="#523b0d" />
          <rect x="44" y="46" width="3.5" height="54" rx="1.5" fill="#523b0d" />
          <rect x="31" y="108" width="22" height="38" fill="#3b3631" />
        </g>

        <!-- Sharpened Rust-Wood Pencil -->
        <g transform="rotate(21 98 95)">
          <path d="M84 12 L72 40 C76 42, 80 39, 84 42 C88 39, 92 42, 96 40 Z" fill="#dfc496" />
          <path d="M84 12 L79 24 C82 25, 86 25, 89 24 Z" fill="#5e240f" />
          <rect x="72" y="39" width="24" height="96" fill="#783015" />
          <rect x="72" y="39" width="8" height="96" fill="#8f3b1b" />
          <rect x="88" y="39" width="8" height="96" fill="#59210c" />
        </g>

        <!-- Eraser-End Olive Pencil -->
        <g transform="rotate(8 118 118)">
          <rect x="108" y="46" width="20" height="16" rx="4" fill="#9e5231" />
          <rect x="107" y="59" width="22" height="13" rx="1.5" fill="#6b5c2b" />
          <line x1="107" y1="64" x2="129" y2="64" stroke="#4f431d" stroke-width="1.5" />
          <line x1="107" y1="68" x2="129" y2="68" stroke="#4f431d" stroke-width="1.5" />
          <rect x="108" y="72" width="20" height="80" fill="#a8761e" />
          <rect x="108" y="72" width="6" height="80" fill="#bf8928" />
          <rect x="122" y="72" width="6" height="80" fill="#7d5612" />
        </g>
      </svg>
    </div>

    <!-- R-Mid: Half-Shown Paperclipped Ivory Slip -->
    <div class="owl-scrap owl-scrap-paperclip bottom-item-clip" data-draggable-hero data-rot="-8" role="button" tabindex="0">
      <svg class="paperclip-svg" viewBox="0 0 32 58" fill="none">
        <path d="M20 15 L19 43 C19 51, 8 51, 8 43 L9 12 C9 4, 24 4, 24 12 L23 39" stroke="rgba(45, 22, 8, 0.25)" stroke-width="3" stroke-linecap="round"/>
        <path d="M18 14 L17 42 C17 49, 7 49, 7 42 L8 11 C8 3, 22 3, 22 11 L21 37 C21 42, 13 42, 13 37 L14 16" stroke="#7d3b1e" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      <div class="scrap-clip-text">
        <span>DON'T</span>
        <span>OVERTHINK</span>
        <svg class="hand-bottom-strokes" viewBox="0 0 92 8" fill="none" aria-hidden="true">
          <path d="M2 3 L88 2 M16 6.5 L74 5.5" stroke="#331d0e" stroke-width="1.9" stroke-linecap="round"/>
        </svg>
      </div>
      <svg class="scrap-heart-svg" viewBox="0 0 22 20" fill="none" aria-hidden="true">
        <path d="M11 18 C11 18, 2 12, 2 6.5 C2 3.5, 4.5 1.5, 7.2 1.5 C9 1.5, 10.3 2.5, 11 3.8 C11.7 2.5, 13 1.5, 14.8 1.5 C17.5 1.5, 20 3.5, 20 6.5 C20 12, 11 18, 11 18 Z" fill="#8c3b1e"/>
      </svg>
    </div>

    <!-- R-Front: Half-Shown Growth Bar Chart Card -->
    <div class="owl-scrap owl-scrap-growth bottom-item-growth" data-draggable-hero data-rot="11" role="button" tabindex="0">
      <div class="scrap-growth-head">GROWTH</div>
      <svg class="scrap-chart-svg" viewBox="0 0 116 78" fill="none">
        <path d="M12 42 C38 38, 68 24, 96 7 M86 6 L97 6 L95 17" stroke="#331d0e" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="14" y="50" width="13" height="24" rx="1" fill="#435232"/>
        <rect x="36" y="40" width="13" height="34" rx="1" fill="#435232"/>
        <rect x="58" y="27" width="13" height="47" rx="1" fill="#435232"/>
        <rect x="80" y="15" width="13" height="59" rx="1" fill="#435232"/>
      </svg>
    </div>
  </div>
</div>
