---
import OwlSideNotes from './OwlSideNotes.astro';
import OwlHeadHotspots from './OwlHeadHotspots.astro';
---

<section class="hero-stage" id="top" aria-labelledby="hero-headline">
  <h1 id="hero-headline" class="sr-only">
    Sophia Notes — Every thought in your head, organized in one place.
  </h1>

  <div class="hero-centered-container">
    <!-- Full-Viewport Stage: Interactive Owl in the Center + Draggable Notes & Desk Items -->
    <div class="hero-artwork-stage">
      <OwlSideNotes />
      <div class="hero-owl-stage-box">
        <OwlHeadHotspots />

        <div class="hero-owl-figure">
          <picture class="hero-owl-picture">
            <source
              type="image/webp"
              srcset="/images/hero/owl-hero-480.webp 480w, /images/hero/owl-hero-768.webp 768w, /images/hero/owl-hero-1024.webp 1024w"
              sizes="(max-width: 640px) 80vw, (max-width: 1024px) 64vw, 600px"
            />
            <img
              class="hero-owl-img"
              src="/images/hero/owl-hero-1024.webp"
              alt="Illustrated autumn owl with an open mind overflowing with organized notes, reminders, to-do lists, and creative ideas"
              width="1024"
              height="935"
              fetchpriority="high"
              decoding="async"
              draggable="false"
            />
          </picture>

          <!-- Interactive Eyes Overlay (Follows Cursor + Blinks Slowly Every 3 Seconds) -->
          <svg
            class="hero-owl-eyes-svg"
            viewBox="0 0 1024 935"
            fill="none"
            aria-hidden="true"
          >
            <defs>
              <clipPath id="owl-eye-clip-left">
                <circle cx="353.5" cy="722.5" r="68.5" />
              </clipPath>
              <clipPath id="owl-eye-clip-right">
                <circle cx="681" cy="724" r="69" />
              </clipPath>
            </defs>

            <!-- LEFT EYE -->
            <g clip-path="url(#owl-eye-clip-left)">
              <!-- Warm Quilt Cream Sclera Base -->
              <circle cx="353.5" cy="722.5" r="70" fill="#f4e3ca" />
              <!-- Subtle Top Socket Shade -->
              <path d="M283 705 A70 70 0 0 1 424 705 A70 64 0 0 0 283 705 Z" fill="#e3cca9" opacity="0.65" />
              <!-- Mouse-Tracking Pupil & Cute Specular Catchlights (Smaller Default, Dilates When Dragging Notes) -->
              <g class="owl-pupil-track" data-eye="left" data-eye-cx="353.5" data-eye-cy="722.5">
                <g class="owl-pupil-scale" style="transform-origin: 353.5px 722.5px">
                  <circle cx="353.5" cy="722.5" r="41" fill="#2b201f" />
                  <circle cx="341" cy="699" r="13.5" fill="#fffdf8" />
                  <circle cx="364" cy="712" r="5.5" fill="#fffdf8" />
                  <circle cx="344" cy="738" r="3.2" fill="#fffdf8" opacity="0.88" />
                </g>
              </g>
              <!-- Slow Blinking Upper & Lower Bear Fur Feather Eyelids -->
              <rect class="owl-eyelid-top" x="278" y="648" width="152" height="82" fill="#975837" />
              <path class="owl-eyelid-lash" d="M284 723 Q353.5 734 423 723" stroke="#392b2a" stroke-width="5" stroke-linecap="round" />
              <rect class="owl-eyelid-bottom" x="278" y="722" width="152" height="80" fill="#82492c" />
            </g>
            <!-- Crisp Inner Eye Socket Rim -->
            <circle cx="353.5" cy="722.5" r="68.5" stroke="#483428" stroke-width="4" fill="none" />

            <!-- RIGHT EYE -->
            <g clip-path="url(#owl-eye-clip-right)">
              <!-- Warm Quilt Cream Sclera Base -->
              <circle cx="681" cy="724" r="70.5" fill="#f4e3ca" />
              <!-- Subtle Top Socket Shade -->
              <path d="M610 706 A70 70 0 0 1 752 706 A70 64 0 0 0 610 706 Z" fill="#e3cca9" opacity="0.65" />
              <!-- Mouse-Tracking Pupil & Cute Specular Catchlights (Smaller Default, Dilates When Dragging Notes) -->
              <g class="owl-pupil-track" data-eye="right" data-eye-cx="681" data-eye-cy="724">
                <g class="owl-pupil-scale" style="transform-origin: 681px 724px">
                  <circle cx="681" cy="724" r="41" fill="#2b201f" />
                  <circle cx="668.5" cy="700.5" r="13.5" fill="#fffdf8" />
                  <circle cx="691.5" cy="713.5" r="5.5" fill="#fffdf8" />
                  <circle cx="671.5" cy="739.5" r="3.2" fill="#fffdf8" opacity="0.88" />
                </g>
              </g>
              <!-- Slow Blinking Upper & Lower Bear Fur Feather Eyelids -->
              <rect class="owl-eyelid-top" x="605" y="650" width="152" height="82" fill="#975837" />
              <path class="owl-eyelid-lash" d="M611 724.5 Q681 735.5 751 724.5" stroke="#392b2a" stroke-width="5" stroke-linecap="round" />
              <rect class="owl-eyelid-bottom" x="605" y="724" width="152" height="80" fill="#82492c" />
            </g>
            <!-- Crisp Inner Eye Socket Rim -->
            <circle cx="681" cy="724" r="69" stroke="#483428" stroke-width="4" fill="none" />

            <!-- Cute Rosy Bear Mug Feather Cheeks (Glow Gently When Squinting or Excited) -->
            <g class="owl-cute-cheeks">
              <ellipse cx="268" cy="786" rx="29" ry="15.5" fill="#bd625d" opacity="0.48" transform="rotate(-10 268 786)" />
              <ellipse cx="766" cy="788" rx="29" ry="15.5" fill="#bd625d" opacity="0.48" transform="rotate(10 766 788)" />
            </g>

            <!-- Ambient Animated Details on Owl Artwork: Ringing Alarm Vibrations, Glowing Idea Rays & Floating Sparkles -->
            <g class="owl-head-bell-waves">
              <path d="M 255 345 C 242 332, 244 312, 258 302" stroke="#ac4e32" stroke-width="3.2" stroke-linecap="round" />
              <path d="M 243 352 C 226 334, 229 306, 248 292" stroke="#e4a555" stroke-width="2.6" stroke-linecap="round" />
              <path d="M 488 335 C 501 322, 499 302, 485 292" stroke="#ac4e32" stroke-width="3.2" stroke-linecap="round" />
              <path d="M 500 342 C 517 324, 514 296, 495 282" stroke="#e4a555" stroke-width="2.6" stroke-linecap="round" />
            </g>

            <g class="owl-head-bulb-glow">
              <circle cx="198" cy="474" r="26" fill="#e4a555" opacity="0.32" />
              <line x1="198" y1="434" x2="198" y2="422" stroke="#e4a555" stroke-width="3" stroke-linecap="round" />
              <line x1="168" y1="448" x2="158" y2="440" stroke="#e4a555" stroke-width="3" stroke-linecap="round" />
              <line x1="228" y1="448" x2="238" y2="440" stroke="#e4a555" stroke-width="3" stroke-linecap="round" />
            </g>

            <g class="owl-head-sparkles">
              <path class="owl-sparkle-1" d="M 118 220 L 122 232 L 134 236 L 122 240 L 118 252 L 114 240 L 102 236 L 114 232 Z" fill="#e4a555" stroke="#392b2a" stroke-width="1.8" stroke-linejoin="round" />
              <path class="owl-sparkle-2" d="M 920 265 L 923 275 L 933 278 L 923 281 L 920 291 L 917 281 L 907 278 L 917 275 Z" fill="#bd625d" stroke="#392b2a" stroke-width="1.8" stroke-linejoin="round" />
              <path class="owl-sparkle-3" d="M 628 42 L 631 51 L 640 54 L 631 57 L 628 66 L 625 57 L 616 54 L 625 51 Z" fill="#e4a555" stroke="#392b2a" stroke-width="1.8" stroke-linejoin="round" />
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroInteractive } from '../../scripts/heroInteractive';
  initHeroInteractive();
</script>
