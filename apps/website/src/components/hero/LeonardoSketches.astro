---
interface Props {
  sketchId: 'polyhedron' | 'ornithopter' | 'compass';
}

const { sketchId } = Astro.props;
---

{sketchId === 'polyhedron' && (
  <svg
    class="sketch-svg"
    viewBox="0 0 92 92"
    fill="none"
    role="img"
    aria-label="Leonardo study of a regular icosahedron"
  >
    <polygon
      points="46,6 82,26 82,66 46,86 10,66 10,26"
      stroke="currentColor"
      stroke-width="1.25"
    />
    <polygon
      points="46,19 71,61 21,61"
      stroke="var(--accent-terracotta)"
      stroke-width="1.15"
    />
    <line x1="46" y1="6" x2="46" y2="19" stroke="currentColor" stroke-width="1" />
    <line x1="82" y1="26" x2="46" y2="19" stroke="currentColor" stroke-width="1" />
    <line x1="10" y1="26" x2="46" y2="19" stroke="currentColor" stroke-width="1" />
    <line x1="82" y1="66" x2="71" y2="61" stroke="currentColor" stroke-width="1" />
    <line x1="10" y1="66" x2="21" y2="61" stroke="currentColor" stroke-width="1" />
    <line x1="46" y1="86" x2="71" y2="61" stroke="currentColor" stroke-width="1" />
    <line x1="46" y1="86" x2="21" y2="61" stroke="currentColor" stroke-width="1" />
    <line x1="10" y1="26" x2="71" y2="61" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 3" />
    <line x1="82" y1="26" x2="21" y2="61" stroke="currentColor" stroke-width="0.75" stroke-dasharray="2 3" />
    <text x="6" y="88" font-family="'IBM Plex Mono', monospace" font-size="7" fill="var(--text-muted)">FIG. I</text>
  </svg>
)}

{sketchId === 'ornithopter' && (
  <svg
    class="sketch-svg"
    viewBox="0 0 112 72"
    fill="none"
    role="img"
    aria-label="Leonardo mechanical wing rib study"
  >
    <!-- Primary Wing Spar Arc -->
    <path
      d="M8 58 Q46 10 104 16"
      stroke="currentColor"
      stroke-width="1.5"
    />
    <path
      d="M8 58 Q54 34 104 16"
      stroke="var(--accent-terracotta)"
      stroke-width="1"
    />
    <!-- Rib Struts -->
    <line x1="26" y1="42" x2="34" y2="62" stroke="currentColor" stroke-width="1" />
    <line x1="46" y1="30" x2="58" y2="58" stroke="currentColor" stroke-width="1" />
    <line x1="68" y1="22" x2="80" y2="50" stroke="currentColor" stroke-width="1" />
    <line x1="88" y1="18" x2="96" y2="40" stroke="currentColor" stroke-width="1" />
    <!-- Trailing Membrane Curve -->
    <path
      d="M8 58 Q22 60 34 62 Q46 56 58 58 Q70 50 80 50 Q89 42 96 40 Q101 28 104 16"
      stroke="currentColor"
      stroke-width="0.9"
      stroke-dasharray="2 2"
    />
    <circle cx="26" cy="42" r="2.5" stroke="var(--accent-terracotta)" stroke-width="1" />
    <text x="8" y="14" font-family="'IBM Plex Mono', monospace" font-size="7" fill="var(--text-muted)">CODEX ATL. 846</text>
  </svg>
)}

{sketchId === 'compass' && (
  <svg
    class="sketch-svg"
    viewBox="0 0 88 88"
    fill="none"
    role="img"
    aria-label="Golden ratio proportional compass and circle study"
  >
    <circle cx="44" cy="44" r="34" stroke="currentColor" stroke-width="1.1" stroke-dasharray="4 3" />
    <rect x="16" y="16" width="56" height="56" stroke="var(--accent-terracotta)" stroke-width="1" />
    <!-- Compass Legs -->
    <line x1="44" y1="10" x2="22" y2="74" stroke="currentColor" stroke-width="1.4" />
    <line x1="44" y1="10" x2="66" y2="74" stroke="currentColor" stroke-width="1.4" />
    <path d="M31 48 A18 18 0 0 0 57 48" stroke="var(--accent-terracotta)" stroke-width="1.1" />
    <circle cx="44" cy="10" r="3" fill="var(--bg-surface)" stroke="currentColor" stroke-width="1.2" />
    <text x="34" y="84" font-family="'IBM Plex Mono', monospace" font-size="7" fill="var(--text-muted)">φ = 1.618</text>
  </svg>
)}
