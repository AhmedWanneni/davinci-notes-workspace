<header class="sophia-nav-header">
  <nav class="nav-stationery-bar" aria-label="Main navigation">
    <!-- Left & Right Brass Thumbtack Pins -->
    <span class="nav-pin nav-pin-left" aria-hidden="true"></span>
    <span class="nav-pin nav-pin-right" aria-hidden="true"></span>

    <a href="/" class="nav-brand">
      <svg class="nav-owl-icon" width="24" height="19" viewBox="0 0 34 26" fill="none" aria-hidden="true">
        <path d="M3 9 C6 3, 13 4, 17 9 C21 4, 28 3, 31 9" stroke="#22160d" stroke-width="2.2" stroke-linecap="round" />
        <circle cx="11.5" cy="13.5" r="5.5" fill="#fffdf8" stroke="#22160d" stroke-width="2.1" />
        <circle cx="22.5" cy="13.5" r="5.5" fill="#fffdf8" stroke="#22160d" stroke-width="2.1" />
        <circle cx="11.5" cy="13.5" r="2.7" fill="#22160d" />
        <circle cx="22.5" cy="13.5" r="2.7" fill="#22160d" />
        <circle cx="10.5" cy="12.2" r="1" fill="#fffdf8" />
        <circle cx="21.5" cy="12.2" r="1" fill="#fffdf8" />
        <path d="M15.3 17.2 L17 21.5 L18.7 17.2 Z" fill="#d4621c" stroke="#22160d" stroke-width="1.7" stroke-linejoin="round" />
        <!-- Little Botanical Berry & Leaf Sprig -->
        <path d="M27 5 C29 2, 33 3, 32 6 C30 7, 28 6, 27 5 Z" fill="#506b42" stroke="#22160d" stroke-width="1.3" />
        <circle cx="27.5" cy="6.5" r="2.1" fill="#c43d2f" stroke="#22160d" stroke-width="1.2" />
      </svg>
      <span class="nav-brand-title">Sophia <em>Notes</em></span>
    </a>

    <span class="nav-divider" aria-hidden="true"></span>

    <div class="nav-links">
      <a href="/#workbench" class="nav-link">Workbench</a>
      <a href="/#features" class="nav-link">Features</a>
      <a href="/#canvas-stage" class="nav-link">Canvas</a>
      <a href="/#sync" class="nav-link">Sync</a>
      <a href="/docs" class="nav-link">Docs</a>
      <a href="https://github.com" target="_blank" rel="noreferrer" class="nav-link">GitHub ↗</a>
    </div>
  </nav>
</header>

<style>
  .sophia-nav-header {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .nav-stationery-bar {
    position: relative;
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 8px 24px;
    background-color: #fffdf8;
    border: 1.8px solid #22160d;
    border-right: 3.5px solid #384f62;
    border-bottom: 3.5px solid #384f62;
    border-radius: 4px 7px 5px 6px / 6px 4px 7px 5px;
    color: #22160d;
  }

  /* Brass & Berry Thumbtack Pins */
  .nav-pin {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 7.5px;
    height: 7.5px;
    background-color: #c43d2f;
    border: 1.5px solid #22160d;
    border-radius: 50%;
    pointer-events: none;
  }

  .nav-pin-left { left: 8px; }
  .nav-pin-right { right: 8px; background-color: #384f62; }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-left: 4px;
    color: #22160d;
  }

  .nav-owl-icon {
    display: block;
    flex-shrink: 0;
  }

  .nav-brand-title {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .nav-brand-title em {
    font-style: italic;
    color: #c43d2f;
  }

  .nav-divider {
    width: 1.5px;
    height: 16px;
    background-color: rgba(34, 22, 13, 0.24);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-right: 4px;
  }

  .nav-link {
    font-family: 'Patrick Hand', var(--font-sans), sans-serif;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #384f62;
    font-weight: 700;
    padding: 1px 0;
    border-bottom: 1.8px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .nav-link:hover {
    color: #c43d2f;
    border-bottom-color: #c43d2f;
  }

  @media (max-width: 768px) {
    .nav-stationery-bar { gap: 10px; padding: 6px 14px; }
    .nav-links { gap: 10px; }
    .nav-link { font-size: 0.85rem; }
  }
</style>
