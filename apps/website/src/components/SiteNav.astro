---
---

<header class="sophia-nav-header">
  <nav class="nav-stationery-bar" aria-label="Main navigation">
    <!-- Left & Right Brass Thumbtack Pins -->
    <span class="nav-pin nav-pin-left" aria-hidden="true"></span>
    <span class="nav-pin nav-pin-right" aria-hidden="true"></span>

    <a href="/" class="nav-brand">
      <svg class="nav-owl-icon" width="22" height="17" viewBox="0 0 32 24" fill="none" aria-hidden="true">
        <path d="M3 8 C6 3, 13 4, 16 8 C19 4, 26 3, 29 8" stroke="#281a0e" stroke-width="2.2" stroke-linecap="round" />
        <circle cx="10.5" cy="12.5" r="5.5" fill="#faf0de" stroke="#281a0e" stroke-width="2.1" />
        <circle cx="21.5" cy="12.5" r="5.5" fill="#faf0de" stroke="#281a0e" stroke-width="2.1" />
        <circle cx="10.5" cy="12.5" r="2.6" fill="#281a0e" />
        <circle cx="21.5" cy="12.5" r="2.6" fill="#281a0e" />
        <path d="M14.5 16.5 L16 20.5 L17.5 16.5 Z" fill="#c85e13" stroke="#281a0e" stroke-width="1.7" stroke-linejoin="round" />
      </svg>
      <span class="nav-brand-title">Sophia <em>Notes</em></span>
    </a>

    <span class="nav-divider" aria-hidden="true"></span>

    <div class="nav-links">
      <a href="/#workbench" class="nav-link">Workbench</a>
      <a href="/#features" class="nav-link">Features</a>
      <a href="/#canvas-stage" class="nav-link">Canvas</a>
      <a href="/#sync" class="nav-link">Sync</a>
      <a href="/docs" class="nav-link">Docs</a>
      <a href="https://github.com" target="_blank" rel="noreferrer" class="nav-link">GitHub ↗</a>
    </div>
  </nav>
</header>

<style>
  .sophia-nav-header {
    position: fixed;
    top: 14px;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    pointer-events: none;
  }

  .nav-stationery-bar {
    position: relative;
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    padding: 8px 24px;
    background-color: #f3e3c6;
    border: 1.7px solid #281a0e;
    border-radius: 4px 7px 5px 6px / 6px 4px 7px 5px;
    color: #26180d;
  }

  /* Tactile Paper Offset Backing */
  .nav-stationery-bar::before {
    content: "";
    position: absolute;
    inset: 0;
    background-color: rgba(48, 28, 12, 0.14);
    border-radius: inherit;
    transform: translate(3px, 4px);
    z-index: -1;
    pointer-events: none;
  }

  /* Brass Thumbtack Pins */
  .nav-pin {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 7px;
    height: 7px;
    background-color: #c38b32;
    border: 1.4px solid #281a0e;
    border-radius: 50%;
    pointer-events: none;
  }

  .nav-pin-left { left: 8px; }
  .nav-pin-right { right: 8px; }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-left: 4px;
    color: #1c140d;
  }

  .nav-owl-icon {
    display: block;
    flex-shrink: 0;
  }

  .nav-brand-title {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .nav-brand-title em {
    font-style: italic;
    color: var(--accent-terracotta);
  }

  .nav-divider {
    width: 1.5px;
    height: 16px;
    background-color: rgba(40, 26, 14, 0.28);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-right: 4px;
  }

  .nav-link {
    font-family: 'Patrick Hand', var(--font-sans), sans-serif;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #3b2615;
    padding: 1px 0;
    border-bottom: 1.6px solid transparent;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .nav-link:hover {
    color: #1c140d;
    border-bottom-color: #c85e13;
  }

  @media (max-width: 768px) {
    .nav-stationery-bar { gap: 10px; padding: 6px 14px; }
    .nav-links { gap: 10px; }
    .nav-link { font-size: 0.85rem; }
  }
</style>
