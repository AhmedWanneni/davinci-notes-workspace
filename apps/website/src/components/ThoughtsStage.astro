---
import './ThoughtsStage.css';
---

<section class="logseq-thoughts-section" id="thoughts-mess">
  <div class="logseq-container">
    <div class="thoughts-stage-viewport">
      <!-- Ambient Dark Vignette -->
      <div class="thoughts-radial-glow" aria-hidden="true"></div>

      <!-- Center Big Typography -->
      <h2 class="thoughts-hero-text">thoughts?</h2>

      <!-- Scattered Everyday Media Clutter Items -->
      <div class="clutter-scatter-layer" aria-hidden="true">
        <!-- YouTube Thumbnail / Video Card -->
        <div class="clutter-item item-youtube">
          <div class="yt-badge">
            <svg viewBox="0 0 24 24" width="28" height="28" fill="#ff0000"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <div class="yt-preview-box">
            <span class="yt-bar bar-1"></span>
            <span class="yt-bar bar-2"></span>
          </div>
        </div>

        <!-- Twitter / X Card -->
        <div class="clutter-item item-tweet">
          <div class="tweet-bird">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="#00c4cc"><path d="M23.954 4.569c-.885.389-1.83.654-2.825.775 1.014-.611 1.794-1.574 2.163-2.723-.951.555-2.005.959-3.127 1.184-.896-.959-2.173-1.559-3.591-1.559-2.717 0-4.92 2.203-4.92 4.917 0 .39.045.765.127 1.124C7.691 8.094 4.066 6.13 1.64 3.161c-.427.722-.666 1.561-.666 2.475 0 1.71.87 3.213 2.188 4.096-.807-.026-1.566-.248-2.228-.616v.061c0 2.385 1.693 4.374 3.946 4.827-.413.111-.849.171-1.296.171-.314 0-.615-.03-.916-.086.631 1.953 2.445 3.377 4.604 3.417-1.68 1.319-3.809 2.105-6.102 2.105-.39 0-.779-.023-1.17-.067 2.18 1.394 4.768 2.209 7.557 2.209 9.054 0 13.999-7.496 13.999-13.986 0-.209 0-.42-.015-.63.961-.689 1.8-1.56 2.46-2.548l-.047-.02z"/></svg>
          </div>
          <div class="tweet-lines">
            <span class="tweet-line"></span>
            <span class="tweet-line short"></span>
          </div>
        </div>

        <!-- Notebook with Pen -->
        <div class="clutter-item item-notebook">
          <div class="spiral-binding">
            <span></span><span></span><span></span><span></span><span></span><span></span>
          </div>
          <div class="notebook-sheet">
            <span class="rule"></span>
            <span class="rule"></span>
            <span class="rule"></span>
          </div>
        </div>

        <!-- Sticky Note "Idea" -->
        <div class="clutter-item item-stickynote">
          <span class="sticky-text">idea</span>
        </div>

        <!-- PDF Document -->
        <div class="clutter-item item-pdf">
          <div class="pdf-tag">PDF</div>
          <div class="pdf-lines">
            <span></span><span></span><span></span>
          </div>
        </div>

        <!-- Smartphone Mockup -->
        <div class="clutter-item item-mobile">
          <div class="phone-screen">
            <div class="phone-notch"></div>
            <div class="phone-stream">
              <span class="stream-pill"></span>
              <span class="stream-box"></span>
              <span class="stream-box"></span>
            </div>
          </div>
        </div>

        <!-- Omnibar Search Box -->
        <div class="clutter-item item-omnibar">
          <div class="omnibar-search">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <span>Search or jump to...</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Subtitle Transformation Statement -->
    <p class="thoughts-statement">
      Davinci Notes helps you <strong>turn this daily mess into structured information.</strong>
    </p>
  </div>
</section>
