---
interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

interface NavItem {
  title: string;
  href: string;
  icon: string;
}

interface NavGroup {
  group: string;
  items: NavItem[];
}

const navGroups: NavGroup[] = [
  {
    group: 'Getting Started',
    items: [
      { title: 'Overview & Architecture', href: '/docs', icon: '🏛️' },
    ],
  },
  {
    group: 'Editor & Workspace',
    items: [
      { title: 'CodeMirror 6 & Markdown', href: '/docs/editor', icon: '✍️' },
      { title: 'Infinite Visual Canvas', href: '/docs/canvas', icon: '🎨' },
    ],
  },
  {
    group: 'Graph & Discovery',
    items: [
      { title: 'Graph View & Backlinks', href: '/docs/graph', icon: '🕸️' },
      { title: 'Search & Quick Switcher', href: '/docs/search', icon: '🔍' },
    ],
  },
  {
    group: 'Sync & Infrastructure',
    items: [
      { title: 'Local-First Sync & Pairing', href: '/docs/sync', icon: '🔄' },
      { title: 'Google Calendar & Tray', href: '/docs/calendar', icon: '📅' },
    ],
  },
  {
    group: 'AI & Automation',
    items: [
      { title: 'DaVinci AI Engine & Privacy', href: '/docs/ai', icon: '✨' },
      { title: 'Web Clipper & Quick Capture', href: '/docs/clipper', icon: '✂️' },
      { title: 'Terminal CLI Workflow', href: '/docs/cli', icon: '💻' },
    ],
  },
  {
    group: 'Extensibility & Mobile',
    items: [
      { title: 'Plugin & Theme Ecosystem', href: '/docs/plugins', icon: '🧩' },
      { title: 'Mobile Experience (Expo)', href: '/docs/mobile', icon: '📱' },
    ],
  },
];

const normalize = (path: string) => path.replace(/\/$/, '') || '/';
const activePath = normalize(currentPath);
---

<aside class="docs-sidebar" aria-label="Documentation Navigation">
  {navGroups.map((group) => (
    <div class="docs-sidebar-group">
      <div class="docs-sidebar-heading">{group.group}</div>
      <ul class="docs-sidebar-list">
        {group.items.map((item) => {
          const itemPath = normalize(item.href);
          const isActive = activePath === itemPath;
          return (
            <li>
              <a
                href={item.href}
                class:list={['docs-sidebar-link', { 'is-active': isActive }]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span aria-hidden="true">{item.icon}</span>
                <span>{item.title}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</aside>
