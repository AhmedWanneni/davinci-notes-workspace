        </a>
      </div>
      <a href="https://producthunt.com" target="_blank" rel="noreferrer" class="producthunt-badge">
        <span class="ph-p">P</span>
        <span class="ph-text">Review us on <strong>ProductHunt</strong></span>
      </a>
    </div>
  </div>
</footer>

<style>
  .logseq-site-footer {
    padding: 36px 0;
    border-top: 1px solid var(--logseq-border);
    background-color: var(--logseq-bg);
    font-size: 0.84rem;
    color: var(--logseq-text-muted);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .footer-brand-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background: var(--palette-burgundy);
    color: var(--palette-nude);
    border: 1px solid var(--palette-rose-smoke);
    border-radius: var(--radius-hand-drawn-subtle);
    font-size: 0.75rem;
    font-weight: 800;
  }

  .copyright {
    color: var(--logseq-text-faint);
  }

  .footer-nav {
    display: flex;
    gap: 18px;
  }

  .footer-nav a:hover {
    color: var(--palette-rose-smoke);
  }

  .footer-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .social-links {
    display: flex;
    gap: 16px;
    align-items: center;
    color: var(--logseq-text-muted);
  }

  .social-links a:hover {
    color: var(--palette-nude);
  }

  .producthunt-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border: 1.5px solid var(--logseq-border);
    border-radius: var(--radius-hand-drawn-subtle);
    background-color: var(--logseq-card);
    color: var(--logseq-text-title);
    font-size: 0.78rem;
    box-shadow: none !important;
    transition: all 140ms ease;
  }

  .producthunt-badge:hover {
    border-color: var(--palette-rose-smoke);
    background-color: var(--palette-burgundy);
  }

  .ph-p {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background-color: #da552f;
    color: #ffffff;
    font-weight: 800;
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
