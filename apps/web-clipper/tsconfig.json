{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": false
  },
  "include": ["entrypoints/**/*", "src/**/*", "types/**/*", "wxt.config.ts"],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.stories.tsx",
    ".output",
    ".wxt",
    "node_modules"
  ]
}
