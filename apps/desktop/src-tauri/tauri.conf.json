{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sophia",
  "version": "0.3.0",
  "identifier": "com.sophia.notes",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev:web",
    "beforeBuildCommand": "pnpm build:web"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/syncthing"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AhmedWanneni/davinci-notes-workspace/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExQjgyQzgzQUY2REZENkQKUldTWUhkV29nME9MTEJvVURmRGFGdlB4S0dYQW9oVzIxdXBYWlhrdTZpT1B5NSt3eG5nNGRwazkK"
    },
    "sql": {
      "preload": [
        "sqlite:vault-index.db"
      ]
    }
  }
}
