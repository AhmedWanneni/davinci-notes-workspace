{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "color-no-hex": [true, { "severity": "error" }],
    "media-feature-range-notation": "prefix",
    "scss/dollar-variable-pattern": "^[a-z0-9-]+$",
    "selector-class-pattern": [
      "^[a-z]([a-z0-9-]+)?(__[a-z0-9-]+)?(--[a-z0-9-]+)?$",
      {
        "message": "Expected class selector to follow kebab-case and BEM pattern (e.g. .block, .block__element, .block__element--modifier)"
      }
    ],
    "keyframes-name-pattern": null,
    "declaration-block-single-line-max-declarations": null
  },
  "overrides": [
    {
      "files": ["src/styles/components/**/*.scss"],
      "rules": {
        "selector-class-pattern": [
          "^[a-z]([a-z0-9-]+)?(__[a-z0-9-]+)?(--[a-z0-9-]+)?$",
          {
            "message": "Expected class selector in components/ to follow BEM pattern (e.g. .block, .block__element, .block__element--modifier)"
          }
        ]
      }
    }
  ]
}
