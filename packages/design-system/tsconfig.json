{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "types": ["react", "react-dom"],
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "index.ts",
    "components/**/*.ts",
    "components/**/*.tsx",
    "tokens/dist/tokens.ts",
    "scss-modules.d.ts"
  ],
  "exclude": [
    "**/*.stories.tsx",
    "**/*.test.tsx",
    ".storybook",
    "vitest.config.ts",
    "vitest.setup.ts",
    "dist"
  ]
}
